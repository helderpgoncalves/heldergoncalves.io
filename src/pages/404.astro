---
import OS from '../layouts/OS.astro';
import Shell from '../components/os/Shell.astro';
import { COPY } from '../siteConfig';
import { getPosts } from '../lib/posts';

const lang = 'pt' as const;
const c = COPY[lang];
const posts = await getPosts(lang);
---
<OS lang={lang} title={`404 — ${c.notFound.title}`} description={c.notFound.lead} noindex>
  <Shell
    lang={lang}
    posts={posts}
    bootMac="sobre"
    docTitle={c.notFound.title}
    docLead={`${c.notFound.lead} · ${COPY.en.notFound.lead}`}
  />
</OS>
