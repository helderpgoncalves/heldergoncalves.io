---
// 404 minimal, sem indexação. Sai da página em qualquer das línguas.
import { SITE } from '../siteConfig';
import '../styles/app.css';
---
<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Página não encontrada — {SITE.name}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="page">
      <main id="main">
        <div class="icon" aria-hidden="true">H</div>
        <h1>404</h1>
        <p class="subtitle">Esta página não existe · This page does not exist</p>
        <div class="intro">
          <p><a href="/">Voltar ao início</a> · <a href="/en/">Back home</a></p>
        </div>
      </main>
    </div>
  </body>
</html>
