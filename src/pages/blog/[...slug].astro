---
import Base from '../../layouts/Base.astro';
import BlogNav from '../../components/BlogNav.astro';
import { SITE } from '../../siteConfig';
import { getSubstackPosts, type SubstackPost } from '../../lib/substack';

// Uma página por post do Substack — gerada no build a partir do feed.
// O canonical aponta para o TEU domínio (SEO acumula em heldergoncalves.io).
export async function getStaticPaths() {
  const posts = await getSubstackPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

type Props = { post: SubstackPost };
const { post } = Astro.props;

const fmt = (date: Date) =>
  date.toLocaleDateString('pt-PT', { day: '2-digit', month: 'long', year: 'numeric' });

const canonical = new URL(`/blog/${post.slug}/`, SITE.url).href;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.pubDate.toISOString(),
  author: { '@type': 'Person', name: SITE.name, url: SITE.url },
  publisher: { '@type': 'Person', name: SITE.name },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  inLanguage: 'pt-PT',
  image: new URL(SITE.ogImage, SITE.url).href,
};
---
<Base
  title={`${post.title} — Hélder Gonçalves`}
  description={post.description}
  type="article"
  publishedTime={post.pubDate.toISOString()}
  noHreflang={true}
  jsonLd={articleLd}
>
  <BlogNav back="/blog" backLabel="Todos os posts" />

  <article class="article">
    <header class="article-head">
      <div class="article-meta">
        <time datetime={post.pubDate.toISOString()}>{fmt(post.pubDate)}</time>
      </div>
      <h1 class="article-h1 serif">{post.title}</h1>
      {!post.hasBody && <p class="article-desc">{post.description}</p>}
    </header>

    {post.hasBody ? (
      <div class="prose" set:html={post.html} />
    ) : (
      <div class="prose">
        <p>Este post foi publicado no Substack. Lê a versão completa lá:</p>
      </div>
    )}

    <footer class="article-foot">
      <a href={post.substackUrl} target="_blank" rel="noopener" class="article-substack liquid-glass">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22 5.5H2V3h20v2.5ZM2 8.4h20V21l-10-5.6L2 21V8.4Z"/></svg>
        {post.hasBody ? 'Originalmente no Substack' : 'Ler no Substack'}
      </a>
      <a href="/blog" class="article-backlink">← Voltar a todos os posts</a>
    </footer>
  </article>
</Base>
