---
import OS from '../../layouts/OS.astro';
import Shell from '../../components/os/Shell.astro';
import { SITE, COPY, ROUTES } from '../../siteConfig';
import { getPosts } from '../../lib/posts';
import { personLd } from '../../lib/seo';

const lang = 'en' as const;
const c = COPY[lang];
const posts = await getPosts(lang);
---
<OS
  lang={lang}
  title={c.title}
  description={c.description}
  altPath={ROUTES.pt.home}
  ogType="profile"
  jsonLd={personLd(lang)}
>
  <Shell lang={lang} posts={posts} bootMac="sobre" docTitle={SITE.name} docLead={c.description} />
</OS>
