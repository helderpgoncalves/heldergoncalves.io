---
// Notes archive (EN).
import Base from '../../../layouts/Base.astro';
import { SITE } from '../../../siteConfig';
import { useT, formatDate } from '../../../i18n/ui';
import { getPosts } from '../../../lib/posts';

const lang = 'en' as const;
const t = useT(lang);
const posts = await getPosts(lang);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': `${SITE.url}/en/blog/#blog`,
    name: `${t('writing.index.title')} — ${SITE.name}`,
    description: t('writing.index.description'),
    inLanguage: 'en',
    author: { '@id': `${SITE.url}/#person` },
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: new URL(p.href, SITE.url).href,
      datePublished: p.data.date.toISOString(),
    })),
  },
];
---
<Base
  lang={lang}
  title={t('writing.index.title')}
  description={t('writing.index.description')}
  alternates={{ pt: '/blog/', en: '/en/blog/' }}
  jsonLd={jsonLd}
>
  <section class="block" style="border-top:none;padding-top:72px">
    <div class="wrap">
      <div class="block-head">
        <p class="eyebrow">{t('writing.eyebrow')}</p>
        <h1>{t('writing.index.title')}</h1>
        <p>{t('writing.intro')}</p>
      </div>

      {posts.length === 0 ? (
        <p class="empty">{t('writing.empty')}</p>
      ) : (
        <div class="notes">
          {posts.map((post) => (
            <article class="note-row">
              <h2 style="font-size:1.0625rem"><a href={post.href}>{post.data.title}</a></h2>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
              <p>{post.data.description}</p>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
