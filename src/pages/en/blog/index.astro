---
import OS from '../../../layouts/OS.astro';
import Shell from '../../../components/os/Shell.astro';
import { SITE, COPY, ROUTES, other } from '../../../siteConfig';
import { getPosts, postPath } from '../../../lib/posts';
import { blogLd } from '../../../lib/seo';

const lang = 'en' as const;
const c = COPY[lang];
const posts = await getPosts(lang);
const blogUrl = new URL(ROUTES[lang].blog, SITE.url).href;
const ld = blogLd(
  lang,
  blogUrl,
  posts.map((p) => ({ title: p.data.title, url: new URL(postPath(p, lang), SITE.url).href }))
);
---
<OS
  lang={lang}
  title={`${c.escritos.title} — ${SITE.name}`}
  description={c.escritos.description}
  altPath={ROUTES[other(lang)].blog}
  jsonLd={ld}
>
  <Shell lang={lang} posts={posts} boot="escritos" docTitle={c.escritos.heading} docLead={c.escritos.lead} />
</OS>
