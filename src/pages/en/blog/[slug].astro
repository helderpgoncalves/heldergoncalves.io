---
// A single note (EN).
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import Article from '../../../components/Article.astro';
import { SITE } from '../../../siteConfig';
import { getPosts, getTranslation } from '../../../lib/posts';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts('en');
  return Promise.all(
    posts.map(async (post) => {
      const twin = await getTranslation(post.data.translationKey, 'pt');
      return {
        params: { slug: post.slug },
        props: { post, altPt: twin?.href ?? '/blog/' },
      };
    })
  );
};

const { post, altPt } = Astro.props;
const { Content } = await post.entry.render();

const url = new URL(post.href, SITE.url).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    inLanguage: 'en',
    datePublished: post.data.date.toISOString(),
    dateModified: (post.data.updated ?? post.data.date).toISOString(),
    keywords: post.data.tags.join(', '),
    wordCount: post.entry.body.trim().split(/\s+/).length,
    author: { '@id': `${SITE.url}/#person` },
    publisher: { '@id': `${SITE.url}/#person` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    image: new URL(SITE.ogImage, SITE.url).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/en/' },
      { '@type': 'ListItem', position: 2, name: 'Notes', item: SITE.url + '/en/blog/' },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
---
<Base
  lang="en"
  title={post.data.title}
  description={post.data.description}
  keywords={post.data.tags.join(', ')}
  type="article"
  published={post.data.date}
  modified={post.data.updated ?? post.data.date}
  alternates={{ pt: altPt, en: post.href }}
  jsonLd={jsonLd}
>
  <Article lang="en" post={post}>
    <Content />
  </Article>
</Base>
