---
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';
import { COPY, ROUTES } from '../siteConfig';
import { personLd } from '../lib/seo';

const lang = 'pt' as const;
const c = COPY[lang];
---
<Base
  lang={lang}
  title={c.title}
  description={c.description}
  altPath={ROUTES.en.home}
  ogType="profile"
  jsonLd={personLd(lang)}
  wide
>
  <Home lang={lang} />
</Base>
