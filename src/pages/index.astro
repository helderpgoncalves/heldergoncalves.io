---
import OS from '../layouts/OS.astro';
import Shell from '../components/os/Shell.astro';
import { SITE, COPY, ROUTES } from '../siteConfig';
import { getPosts } from '../lib/posts';
import { personLd, websiteLd } from '../lib/seo';

const lang = 'pt' as const;
const c = COPY[lang];
const posts = await getPosts(lang);
---
<OS
  lang={lang}
  title={c.title}
  description={c.description}
  altPath={ROUTES.en.home}
  ogType="profile"
  jsonLd={[personLd(lang), websiteLd(lang)]}
>
  <Shell lang={lang} posts={posts} docTitle={SITE.name} docLead={c.description} />
</OS>
