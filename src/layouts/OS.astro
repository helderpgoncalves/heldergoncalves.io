---
// A página. O <head> trata do SEO; o corpo é o sistema operativo.
// O primeiro <script> corre antes de pintar: evita o piscar de tema
// e esconde o documento simples quando há JavaScript.
import { SITE, COPY, ROUTES, other, type Lang } from '../siteConfig';
import '../styles/os.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  altPath?: string;
  ogType?: 'website' | 'profile' | 'article';
  keywords?: string;
  noindex?: boolean;
  jsonLd?: unknown;
}

const {
  lang,
  title,
  description,
  altPath,
  ogType = 'website',
  keywords = COPY[lang].keywords,
  noindex = false,
  jsonLd,
} = Astro.props;

const c = COPY[lang];
const r = ROUTES[lang];
const alt = other(lang);

const abs = (path: string) => new URL(path, SITE.url).href;
const canonical = abs(Astro.url.pathname);
const ogImage = abs(SITE.ogImage);
const altHref = altPath ? abs(altPath) : abs(ROUTES[alt].home);
const ptHref = lang === 'pt' ? canonical : altHref;
const enHref = lang === 'en' ? canonical : altHref;
---
<!doctype html>
<html lang={c.htmlLang} data-wallpaper="aurora" data-mode="mac">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={SITE.name} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    <meta name="theme-color" content="#2e5aa8" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-PT" href={ptHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={ptHref} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${SITE.name} — ${c.role}`} />
    <meta property="og:locale" content={c.locale} />
    <meta property="og:locale:alternate" content={COPY[alt].locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content={SITE.twitterHandle} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — ${c.escritos.title}`} href={r.feed} />

    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
    )}

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var p = JSON.parse(localStorage.getItem('helderos') || '{}');
          if (p.theme && p.theme !== 'auto') d.setAttribute('data-theme', p.theme);
          if (p.wallpaper) d.setAttribute('data-wallpaper', p.wallpaper);
          if (p.motion) d.setAttribute('data-motion', p.motion);
          if (p.brightness) d.style.setProperty('--brightness', String(p.brightness));
        } catch (e) {}
        var phone =
          location.search.indexOf('device') > -1 ||
          window.matchMedia('(max-width: 860px), (pointer: coarse) and (max-width: 1180px)').matches;
        d.setAttribute('data-mode', phone ? 'ios' : 'mac');
        if (location.search.indexOf('device') > -1) d.classList.add('in-frame');
        // Se o sistema não arrancar em 5s, devolvemos o documento simples.
        setTimeout(function () {
          var os = document.getElementById('os');
          if (!os || !os.classList.contains('ready')) d.classList.remove('js');
        }, 5000);
      })();
    </script>
  </head>

  <body>
    <a href="#pool" class="skip">{c.skip}</a>
    <slot />
    <script>
      import '../scripts/os/index.js';
    </script>
  </body>
</html>
