---
// A página. O <head> trata do SEO; o corpo é o sistema operativo.
// O primeiro <script> corre antes de pintar: evita o piscar de tema
// e esconde o documento simples quando há JavaScript.
import { SITE, COPY, ROUTES, other, type Lang } from '../siteConfig';
import '../styles/os.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  altPath?: string;
  ogType?: 'website' | 'profile' | 'article';
  keywords?: string;
  noindex?: boolean;
  jsonLd?: unknown;
  /** Datas ISO, só nos escritos. */
  published?: string;
  modified?: string;
}

const {
  lang,
  title,
  description,
  altPath,
  ogType = 'website',
  keywords = COPY[lang].keywords,
  noindex = false,
  jsonLd,
  published,
  modified,
} = Astro.props;

const c = COPY[lang];
const r = ROUTES[lang];
const alt = other(lang);

const abs = (path: string) => new URL(path, SITE.url).href;
const canonical = abs(Astro.url.pathname);
const ogImage = abs(SITE.ogImage);
const altHref = altPath ? abs(altPath) : abs(ROUTES[alt].home);
const llms = lang === 'pt' ? '/llms.txt' : '/en/llms.txt';
const ptHref = lang === 'pt' ? canonical : altHref;
const enHref = lang === 'en' ? canonical : altHref;
---
<!doctype html>
<html lang={c.htmlLang} data-wallpaper="aurora" data-mode="mac">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={SITE.name} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    <meta name="theme-color" content="#2e5aa8" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="color-scheme" content="light dark" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-PT" href={ptHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={ptHref} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${SITE.name} — ${c.role}`} />
    <meta property="og:locale" content={c.locale} />
    <meta property="og:locale:alternate" content={COPY[alt].locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content={SITE.twitterHandle} />

    <!-- O PNG primeiro e o SVG depois: quem sabe SVG fica com o último; o Safari, que não sabe, fica com o PNG. -->
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — ${c.escritos.title}`} href={r.feed} />
    <link rel="alternate" type="text/markdown" href={llms} title="llms.txt" />
    <link rel="me" href={SITE.github} />

    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    {ogType === 'article' && <meta property="article:author" content={SITE.name} />}

    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
    )}

    <script is:inline src="/os-early.js"></script>
  </head>

  <body>
    <a href="#pool" class="skip">{c.skip}</a>
    <slot />
    <script>
      import '../scripts/os/index.js';
    </script>
  </body>
</html>
