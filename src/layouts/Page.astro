---
// A página inteira: <head> de SEO + conteúdo. Serve as duas línguas —
// português na raiz, inglês em /en/. Zero JavaScript no cliente.
import { SITE, COPY, type Lang } from '../siteConfig';
import '../styles/app.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = COPY[lang];

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ptHref = new URL('/', SITE.url).href;
const enHref = new URL('/en/', SITE.url).href;
const ogImage = new URL(SITE.ogImage, SITE.url).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  jobTitle: c.role,
  description: c.description,
  image: ogImage,
  address: { '@type': 'PostalAddress', addressLocality: 'Barcelos', addressCountry: 'PT' },
  worksFor: { '@type': 'Organization', name: SITE.company.name, url: SITE.company.url },
  sameAs: [SITE.github, SITE.linkedin, SITE.twitter],
  knowsAbout: [
    'Software engineering',
    'Artificial intelligence',
    'Large language models',
    'AI agents',
    'Model Context Protocol',
    'Automation',
    'TypeScript',
    'Python',
  ],
};

// O nome da empresa vira link, sem repetir o texto nas duas línguas.
const companyLinked = c.intro2.replace(
  SITE.company.name,
  `<a href="${SITE.company.url}" target="_blank" rel="noopener">${SITE.company.name}</a>`
);

const links = [
  { label: c.labels.email, href: `mailto:${SITE.email}`, text: SITE.email, external: false },
  { label: c.labels.github, href: SITE.github, text: 'github.com/helderpgoncalves', external: true },
  { label: c.labels.linkedin, href: SITE.linkedin, text: 'in/heldergoncalves16', external: true },
  { label: c.labels.twitter, href: SITE.twitter, text: SITE.twitterHandle, external: true },
];
---
<!doctype html>
<html lang={c.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.title}</title>
    <meta name="description" content={c.description} />
    <meta name="keywords" content={c.keywords} />
    <meta name="author" content={SITE.name} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191919" media="(prefers-color-scheme: dark)" />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-PT" href={ptHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={ptHref} />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={c.title} />
    <meta property="og:description" content={c.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${SITE.name} — ${c.role}`} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_PT' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'pt' ? 'en_GB' : 'pt_PT'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={c.title} />
    <meta name="twitter:description" content={c.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content={SITE.twitterHandle} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)}></script>
  </head>

  <body>
    <a href="#main" class="skip">{lang === 'pt' ? 'Saltar para o conteúdo' : 'Skip to content'}</a>

    <div class="page">
      <div class="top">
        <a class="lang" href={c.switchHref} hreflang={lang === 'pt' ? 'en' : 'pt'}>{c.switch}</a>
      </div>

      <main id="main">
        <div class="icon" aria-hidden="true">H</div>
        <h1>{SITE.name}</h1>
        <p class="subtitle">
          {c.role}<span class="dot" aria-hidden="true">·</span>{c.place}
        </p>

        <div class="intro">
          <p>{c.intro}</p>
          <p set:html={companyLinked}></p>
          <p>{c.intro3}</p>
        </div>

        <hr />

        <section aria-labelledby="contact">
          <h2 id="contact">{c.contactTitle}</h2>
          <p class="lead">{c.contactLead}</p>

          <dl class="props">
            {links.map((l) => (
              <div class="prop">
                <dt>{l.label}</dt>
                <dd>
                  <a
                    href={l.href}
                    target={l.external ? '_blank' : undefined}
                    rel={l.external ? 'noopener me' : undefined}
                  >
                    {l.text}
                    {l.external && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7" /><polyline points="7 7 17 7 17 17" /></svg>
                    )}
                  </a>
                </dd>
              </div>
            ))}
            <div class="prop">
              <dt>{c.labels.where}</dt>
              <dd>{c.place}</dd>
            </div>
          </dl>

          <p class="callout">
            <span aria-hidden="true">✳</span>
            <span>
              {lang === 'pt'
                ? 'Disponível para projetos. Diz-me o problema e o prazo — respondo com franqueza se faz sentido.'
                : 'Available for projects. Tell me the problem and the timeline — I will tell you honestly if it makes sense.'}
            </span>
          </p>
        </section>

        <footer>
          © {new Date().getFullYear()} {SITE.name} · {c.footer}
        </footer>
      </main>
    </div>
  </body>
</html>
