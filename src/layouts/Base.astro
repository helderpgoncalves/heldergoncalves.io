---
// Estrutura comum a todas as páginas: <head> de SEO, cabeçalho,
// conteúdo, rodapé e a paleta de comandos.
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Palette from '../components/Palette.astro';
import { useT } from '../i18n/ui';
import type { Lang } from '../siteConfig';
import '../styles/app.css';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  keywords?: string;
  type?: 'website' | 'article';
  image?: string;
  published?: Date;
  modified?: Date;
  alternates?: Partial<Record<Lang, string>>;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { lang, ...seo } = Astro.props;
const t = useT(lang);
---
<!doctype html>
<html lang={lang === 'pt' ? 'pt-PT' : 'en'}>
  <head>
    <Head lang={lang} {...seo} />
  </head>
  <body>
    <a href="#content" class="skip">{t('nav.skip')}</a>
    <Header lang={lang} />
    <main id="content">
      <slot />
    </main>
    <Footer lang={lang} />
    <Palette lang={lang} />
  </body>
</html>
