---
// ─────────────────────────────────────────────────────────────
// SEO.astro — todo o <head> de SEO num só componente.
// Meta padrão + Open Graph + Twitter Card + canonical + hreflang
// + JSON-LD. Renderizado no servidor (0 JS).
//
// Sem props → usa os metadados default do site (home).
// Com props (title/description/type/…) → SEO próprio da página
// (usado pelos artigos do blog para OG `article` + BlogPosting).
// ─────────────────────────────────────────────────────────────
import { SITE, META, type Lang } from '../siteConfig';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: string; // ISO
  noHreflang?: boolean; // páginas sem par de idioma (ex.: posts) escondem o hreflang PT/EN
  jsonLd?: Record<string, unknown>; // dados estruturados extra (ex.: BlogPosting)
}
const {
  lang = SITE.defaultLang,
  title,
  description,
  type = 'website',
  image,
  publishedTime,
  noHreflang = false,
  jsonLd,
} = Astro.props;

const m = META[lang];
const pageTitle = title ?? m.title;
const pageDesc = description ?? m.description;

// URL canónica absoluta desta página.
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageUrl = new URL(image ?? SITE.ogImage, SITE.url).href;

// JSON-LD base — Person + WebSite (sempre presentes).
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  jobTitle: 'Developer',
  description: m.description,
  image: new URL(SITE.ogImage, SITE.url).href,
  sameAs: [SITE.social.twitter, SITE.social.linkedin, SITE.social.substack],
  knowsAbout: ['Software Development', 'Artificial Intelligence', 'Web Development'],
};
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  inLanguage: lang === 'pt' ? 'pt-PT' : 'en',
  author: { '@type': 'Person', name: SITE.name },
};
---
<!-- Fundamentos -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{pageTitle}</title>
<meta name="description" content={pageDesc} />
<meta name="author" content={SITE.name} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="theme-color" content="#000000" />
<link rel="canonical" href={canonical} />

<!-- hreflang — só nas páginas com par de idioma PT/EN -->
{!noHreflang && (
  <>
    <link rel="alternate" hreflang="pt-PT" href={SITE.url + '/'} />
    <link rel="alternate" hreflang="en" href={SITE.url + '/?lang=en'} />
    <link rel="alternate" hreflang="x-default" href={SITE.url + '/'} />
  </>
)}

<!-- Open Graph (Facebook, LinkedIn, WhatsApp…) -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDesc} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={pageTitle} />
<meta property="og:locale" content={lang === 'pt' ? 'pt_PT' : 'en_US'} />
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && <meta property="article:author" content={SITE.name} />}

<!-- Twitter / X Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDesc} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:creator" content={SITE.social.twitterHandle} />
<meta name="twitter:site" content={SITE.social.twitterHandle} />

<!-- Ícones + manifest -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<link rel="manifest" href="/site.webmanifest" />

<!-- RSS -->
<link rel="alternate" type="application/rss+xml" title={SITE.name + ' — Blog'} href={SITE.url + '/rss.xml'} />

<!-- Fonts: preconnect + Instrument Serif -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap"
  rel="stylesheet"
/>

<!-- Dados estruturados -->
<script type="application/ld+json" set:html={JSON.stringify(personLd)} />
<script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
