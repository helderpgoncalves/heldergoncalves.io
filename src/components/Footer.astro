---
// Rodapé: links, idioma e a nota de como o site é feito.
import { SITE, altPath, type Lang } from '../siteConfig';
import { useT } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'pt' ? 'en' : 'pt';
const otherHref = altPath(Astro.url.pathname, other);
const blog = lang === 'pt' ? '/blog/' : '/en/blog/';
const feed = lang === 'pt' ? '/rss.xml' : '/en/rss.xml';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <p>© {year} {SITE.name} · {t('footer.built')}</p>
    <nav aria-label={lang === 'pt' ? 'Rodapé' : 'Footer'}>
      <a href={blog}>{t('nav.writing')}</a>
      <a href={SITE.social.github} target="_blank" rel="noopener me">GitHub</a>
      <a href={SITE.social.linkedin} target="_blank" rel="noopener me">LinkedIn</a>
      <a href={SITE.social.twitter} target="_blank" rel="noopener me">X</a>
      <a href={feed}>RSS</a>
      <a href={otherHref} hreflang={other} lang={other}>{t('footer.lang')}</a>
    </nav>
  </div>
</footer>
