---
// Entrar: um item do menu Apple (Mac) e do menu de sistema (iOS), por
// isso vive fora dos dois, como o Spotlight. É o ecrã de bloqueio do
// macOS a sério — não um diálogo a meio do ecrã: o texto flutua
// directamente sobre o papel de parede desfocado (o `.wall` que já
// existe atrás, em Shell.astro), sem moldura de vidro à volta. Só o
// campo de password é vidro — `.glass` com `.glass-clear` por cima, a
// variante que a regra da Apple reserva a "o que está por baixo é
// forte e vivo" (ver .claude/rules/apple.md, secção Vidro).
// `.glass-clear` sozinha não pinta nada: só troca as variáveis que
// `.glass` lê, por isso as duas andam sempre juntas.
//
// A geometria (espaçamento, tamanho dos avatares, o relógio) segue
// `.entrar-*`, em entrar.css — o mesmo idioma do ecrã de bloqueio a
// sério (`.lock-*`, em ios.css): `--sb-h`/`--home-h` nas margens, nunca
// `vh`, e tudo em múltiplos de 8 ou 4. O Tailwind aqui é só layout
// (flex, grid, largura máxima); a identidade visual vive no CSS.
//
// Todo o `[hidden]` aqui segue o mesmo padrão: `hidden [&:not([hidden])]:flex`.
// A classe `flex`/`grid` sozinha venceria sempre o atributo `hidden`
// nativo (mesma especificidade, ordem no output do Tailwind manda) —
// `:not([hidden])` é o que devolve o controlo ao atributo que o JS
// (lib/entrar.js) liga e desliga.
//
// `bg-white/N`, `text-white/N`: excepção deliberada aos papéis do
// sistema (--surface-2, --ink-2). Este ecrã imita o ecrã de sessão do
// macOS — sempre escuro sobre o wallpaper, como o Control Center — e
// não segue o claro/escuro do resto do site.
import { COPY, type Lang } from '../../siteConfig';
import Icon from './Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = COPY[lang];
---

<div
  class="entrar fixed inset-0 z-[900] hidden flex-col items-center bg-black/10 backdrop-blur-2xl motion-reduce:backdrop-blur-none [[data-motion='off']_&]:backdrop-blur-none [&:not([hidden])]:flex"
  id="entrar"
  hidden
>
  <div class="entrar-body flex w-full flex-1 flex-col items-center text-white">
    <div class="entrar-top" data-entrar-clock aria-hidden="true">
      <span class="entrar-time" data-entrar-time></span>
      <span class="entrar-date" data-entrar-date></span>
    </div>

    <div class="entrar-choices" data-entrar-avatars>
      <button type="button" class="entrar-choice" data-entrar-guest>
        <span class="entrar-avatar" aria-hidden="true">
          <img src="/memoji-visitante.png" alt="" width="96" height="96" />
        </span>
        <span class="entrar-choice-name">{c.os.entrar.guest}</span>
      </button>
      <button type="button" class="entrar-choice" data-entrar-signin>
        <span class="entrar-avatar" aria-hidden="true">
          <Icon id="ui-mail" size={30} />
        </span>
        <span class="entrar-choice-name">{c.os.entrar.signIn}</span>
      </button>
      <a href="/api/auth/google/start" class="entrar-choice" data-entrar-google>
        <span class="entrar-avatar entrar-avatar-solid" aria-hidden="true">
          <Icon id="ui-google" size={30} />
        </span>
        <span class="entrar-choice-name">Google</span>
      </a>
    </div>

    <div class="entrar-signed" data-entrar-signed hidden>
      <span class="entrar-avatar entrar-avatar-lg" aria-hidden="true">
        <Icon id="ui-mail" size={34} />
      </span>
      <p class="entrar-signed-text">
        {c.os.entrar.signedInAs}<br /><strong data-entrar-email-out></strong>
      </p>
      <button type="button" class="btn" data-entrar-signout>{c.calendario.signOut}</button>
    </div>

    <div class="entrar-form" data-entrar-form hidden>
      <span class="entrar-avatar" aria-hidden="true">
        <Icon id="ui-mail" size={30} />
      </span>
      <p class="entrar-form-title">{c.os.entrar.signIn}</p>

      <div class="entrar-request" data-entrar-request>
        <form class="entrar-panel glass glass-clear" data-entrar-email>
          <label class="sr" for="entrar-email">{c.calendario.email}</label>
          <input
            id="entrar-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder={c.calendario.email}
            class="entrar-input"
          />
          <button class="btn btn-primary" type="submit">{c.calendario.sendLink}</button>
        </form>
      </div>

      <div class="entrar-waiting" data-entrar-waiting hidden>
        <span class="entrar-waiting-dot" aria-hidden="true"></span>
        <p class="entrar-waiting-text">
          {c.calendario.linkSent} <strong data-entrar-pending></strong>
        </p>
        <p class="entrar-waiting-hint">{c.calendario.linkHint}</p>
        <button type="button" class="btn entrar-resend" data-entrar-resend>{c.calendario.resend}</button>
      </div>

      <p class="entrar-hint" data-entrar-hint></p>
    </div>
  </div>
</div>
