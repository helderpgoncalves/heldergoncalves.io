---
// A saudação do arranque: a mão a escrever «hello» ou «Olá».
//
// O «hello» é o traçado do componente apple-hello-effect (shadcn.io),
// com os tempos dele: o «h» em 0,8 s, o resto numa penada de 2,8 s que
// arranca aos 0,7 s. Ver NOTICE.md.
//
// O «Olá» é nosso, desenhado curva a curva na mesma métrica — linha de
// base, altura de x e peso de traço do «hello» — e escrito à mesma
// velocidade: o tempo de cada traço vem do comprimento dele, medido
// aqui no build, contra a velocidade a que o «hello» é escrito. Se um
// traçado mudar, o ritmo acompanha; não há números afinados à mão.
//
// Cada letra é um caminho seu. O que se vê é `stroke-dashoffset` a
// baixar letra a letra, cada uma no seu tempo, com a tinta a aparecer
// nos primeiros instantes de cada traço, como no original.
import type { Lang } from '../../siteConfig';

interface Props {
  lang: Lang;
  label: string;
}

const { lang, label } = Astro.props;

type Stroke = { d: string; delay: number; dur: number };

/** O peso do traço, o do original. */
const STROKE = 14.8883;

// ── hello ────────────────────────────────────────────────────────────
const HELLO_H1 =
  'M8.69214 166.553C36.2393 151.239 61.3409 131.548 89.8191 98.0295C109.203 75.1488 119.625 49.0228 120.122 31.0026C120.37 17.6036 113.836 7.43883 101.759 7.43883C88.3598 7.43883 79.9231 17.6036 74.7122 40.9363C69.005 66.5793 64.7866 96.0036 54.1166 190.356';
const HELLO_REST =
  'M55.1624 181.135C60.6251 133.114 81.4118 98.0479 107.963 98.0479C123.844 98.0479 133.937 110.703 131.071 128.817C129.457 139.487 127.587 150.405 125.408 163.06C122.869 178.941 130.128 191.348 152.122 191.348C184.197 191.348 219.189 173.523 237.097 145.915C243.198 136.509 245.68 128.073 245.928 119.884C246.176 104.996 237.739 93.8296 222.851 93.8296C203.992 93.8296 189.6 115.17 189.6 142.465C189.6 171.745 205.481 192.341 239.208 192.341C285.066 192.341 335.86 137.292 359.199 75.8585C365.788 58.513 368.26 42.4065 368.26 31.1512C368.26 17.8057 364.042 7.55823 352.131 7.55823C340.469 7.55823 332.777 16.6141 325.829 30.9129C317.688 47.4967 311.667 71.4162 309.203 98.4549C303 166.301 316.896 191.348 349.936 191.348C390 191.348 434.542 135.534 457.286 75.6686C463.803 58.513 466.275 42.4065 466.275 31.1512C466.275 17.8057 462.057 7.55823 450.146 7.55823C438.484 7.55823 430.792 16.6141 423.844 30.9129C415.703 47.4967 409.682 71.4162 407.218 98.4549C401.015 166.301 414.911 191.348 444.416 191.348C473.874 191.348 489.877 165.67 499.471 138.402C508.955 111.447 520.618 94.8221 544.935 94.8221C565.035 94.8221 580.916 109.71 580.916 137.75C580.916 168.768 560.792 192.093 535.362 192.341C512.984 192.589 498.285 174.475 499.774 147.179C501.511 116.907 519.873 94.8221 543.943 94.8221C557.839 94.8221 569.51 100.999 578.682 107.725C603.549 125.866 622.709 114.656 630.047 96.7186';

const HELLO: Stroke[] = [
  { d: HELLO_H1, delay: 0, dur: 800 },
  { d: HELLO_REST, delay: 700, dur: 2800 },
];

// ── Olá ──────────────────────────────────────────────────────────────
// Desenhado numa caixa pequena e levado para a métrica do «hello» no
// build: linha de base a 191, traço de ~15. Cada entrada é um levantar
// de caneta; a que tem `lift` leva uma pausa antes.
const OLA_RAW: { d: string; lift?: boolean }[] = [
  { d: 'M 36 12 C 18 12 8 34 10 54 C 12 72 30 78 42 64 C 52 52 50 26 40 14 C 36 9 30 12 30 20 C 30 30 40 46 54 48' },
  { d: 'M 54 48 C 62 42 72 24 80 10 C 84 4 87 3 84 8 C 74 20 68 50 68 68 C 68 78 75 78 82 66' },
  { d: 'M 82 66 C 88 56 98 46 108 46 C 118 46 116 68 106 70 C 98 72 94 60 102 50 C 106 46 110 44 112 48 C 110 56 110 66 112 70 C 114 76 120 74 124 66' },
  { d: 'M 108 30 L 118 20', lift: true },
];
const OLA_SCALE = 2.4;
const OLA_SHIFT = { x: -14, y: 191 - 76 * OLA_SCALE };
const OLA_VIEWBOX = '0 0 292 200';

/** Escala e desloca as coordenadas de um caminho com M, L e C. */
function transform(d: string, k: number, tx: number, ty: number): string {
  let axis = 0;
  return d.replace(/-?\d*\.?\d+/g, (n) => {
    const v = parseFloat(n) * k + (axis % 2 === 0 ? tx : ty);
    axis += 1;
    return v.toFixed(2);
  });
}

/** Comprimento de um caminho com M, L e C — o suficiente para o que desenhamos. */
function lengthOf(d: string): number {
  const tokens = d.match(/[MLC]|-?\d*\.?\d+/g) ?? [];
  let i = 0;
  let cur: [number, number] = [0, 0];
  let total = 0;
  const num = () => parseFloat(tokens[i++]);
  const dist = (a: [number, number], b: [number, number]) => Math.hypot(b[0] - a[0], b[1] - a[1]);
  while (i < tokens.length) {
    const t = tokens[i++];
    if (t === 'M') cur = [num(), num()];
    else if (t === 'L') {
      const p: [number, number] = [num(), num()];
      total += dist(cur, p);
      cur = p;
    } else if (t === 'C') {
      const c1: [number, number] = [num(), num()];
      const c2: [number, number] = [num(), num()];
      const p: [number, number] = [num(), num()];
      let prev = cur;
      for (let k = 1; k <= 24; k++) {
        const s = k / 24;
        const u = 1 - s;
        const q: [number, number] = [
          u * u * u * cur[0] + 3 * u * u * s * c1[0] + 3 * u * s * s * c2[0] + s * s * s * p[0],
          u * u * u * cur[1] + 3 * u * u * s * c1[1] + 3 * u * s * s * c2[1] + s * s * s * p[1],
        ];
        total += dist(prev, q);
        prev = q;
      }
      cur = p;
    }
  }
  return total;
}

/** A velocidade da mão no «hello»: unidades por milissegundo. */
const HAND_SPEED = (lengthOf(HELLO_H1) + lengthOf(HELLO_REST)) / (800 + 2800);
const LIFT_MS = 140;

function timeOla(): Stroke[] {
  let at = 0;
  return OLA_RAW.map(({ d, lift }) => {
    const scaled = transform(d, OLA_SCALE, OLA_SHIFT.x, OLA_SHIFT.y);
    if (lift) at += LIFT_MS;
    const dur = Math.round(lengthOf(scaled) / HAND_SPEED);
    const stroke = { d: scaled, delay: at, dur };
    at += dur;
    return stroke;
  });
}

const strokes = lang === 'pt' ? timeOla() : HELLO;
const viewBox = lang === 'pt' ? OLA_VIEWBOX : '0 0 638 200';
/** Quando a mão pousa, para o arranque saber quando seguir. */
const wrote = Math.max(...strokes.map((s) => s.delay + s.dur));
---
<svg
  class="boot-hand"
  viewBox={viewBox}
  fill="none"
  stroke="currentColor"
  stroke-width={STROKE}
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label={label}
  data-wrote={wrote}
>
  <title>{label}</title>
  {strokes.map((s) => (
    <path class="ink" pathLength="1" style={`--delay:${s.delay}ms;--dur:${s.dur}ms`} d={s.d} />
  ))}
</svg>
