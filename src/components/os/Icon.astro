---
// Um ícone do sprite. `id` é o nome do símbolo: 'sobre', 'ui-search'…
interface Props { id: string; class?: string; size?: number; label?: string }
const { id, class: cls = '', size, label } = Astro.props;
const symbol = id.startsWith('ui-') || id.startsWith('icon-') ? id : `icon-${id}`;
const style = size ? `width:${size}px;height:${size}px` : undefined;
---
<svg
  class={cls}
  style={style}
  viewBox="0 0 100 100"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
><use href={`#${symbol}`} /></svg>
