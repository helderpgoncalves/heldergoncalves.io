---
import { COPY, type Lang } from '../../../siteConfig';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = COPY[lang];
---
<section class="app-shell app-terminal" data-content="terminal" aria-label={c.apps.terminal.name}>
  <div class="term" data-term tabindex="-1">
    <div class="term-out" data-term-out>helder@heldergoncalves.io — zsh
{c.terminal.welcome}</div>
    <div class="term-line">
      <span class="ps1">helder ~ %</span>
      <input type="text" data-term-input autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" aria-label="Terminal" />
    </div>
  </div>
</section>
