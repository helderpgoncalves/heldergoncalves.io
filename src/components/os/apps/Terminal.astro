---
import { COPY, type Lang } from '../../../siteConfig';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = COPY[lang];
---
<section class="app-shell app-terminal relative flex min-h-0 flex-col overflow-hidden bg-(--surface-solid)" data-content="terminal" aria-label={c.apps.terminal.name}>
  <div class="term flex min-h-0 flex-1 flex-col overflow-auto bg-[#101013] px-4 py-3.5 font-(family-name:--mono) text-[13px] leading-[1.62] text-[#e6e6e9] [&_b]:font-semibold [&_b]:text-[#ffd60a] [&_i]:not-italic [&_i]:text-[#64d2ff] [&_.muted]:text-[#8e8e93] [&_a]:text-[#64d2ff]" data-term tabindex="-1">
    <div class="term-out whitespace-pre-wrap break-words" data-term-out>helder@heldergoncalves.io — zsh
{c.terminal.welcome}</div>
    <div class="term-line flex gap-2">
      <span class="ps1 flex-none text-[#30d158]">helder ~ %</span>
      <input type="text" data-term-input autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" aria-label="Terminal" class="min-w-0 flex-1 border-0 bg-transparent font-(family-name:--mono) text-inherit text-[#e6e6e9] outline-hidden [caret-color:#30d158]" />
    </div>
  </div>
</section>
