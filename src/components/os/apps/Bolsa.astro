---
// A Bolsa. O que está aqui é o que se lê sem JavaScript: o que a
// aplicação é e que títulos mostra por omissão, na lista e no
// portefólio. O resto — cotações, gráficos, ficha, notícias, a lista
// que se edita — é o JS que o traz do servidor.
import { COPY, type Lang } from '../../../siteConfig';
import Icon from '../Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = COPY[lang];
const b = c.bolsa;
const DEFAULT = ['AAPL', 'MSFT', 'NVDA', 'GOOGL', 'AMZN', 'TSLA', 'BTC-USD', '^GSPC', 'EURUSD=X'];
/** O portefólio do Hélder: VWCE e SXR8 negoceiam na Xetra, por isso o
    símbolo do Yahoo leva o sufixo — a etiqueta que se mostra é a nua. */
const PORTFOLIO = [
  { symbol: 'VWCE.DE', label: 'VWCE' },
  { symbol: 'SXR8.DE', label: 'SXR8' },
  { symbol: 'MSFT', label: 'MSFT' },
];
---
<section class="app-shell app-bolsa" data-content="bolsa" aria-label={c.apps.bolsa.name} data-default={DEFAULT.join(',')} data-portfolio={PORTFOLIO.map((p) => p.symbol).join(',')}>
  <div class="stk-side">
    <div class="stk-head">
      <h2>{c.apps.bolsa.name}</h2>
      <button class="stk-edit" type="button" data-stk-edit>{b.edit}</button>
    </div>
    <div class="stk-add">
      <Icon id="ui-search" size={13} />
      <label class="sr" for="stk-symbol">{b.add}</label>
      <input id="stk-symbol" type="search" placeholder={b.addPlaceholder} autocomplete="off" autocapitalize="characters" spellcheck="false" data-stk-search />
      <div class="stk-suggest" data-stk-suggest hidden></div>
    </div>

    <div class="stk-groups" data-stk-scroll>
      <div class="stk-group">
        <p class="stk-group-name">{b.list}</p>
        <ul class="stk-list" data-stk-list="watch">
          {DEFAULT.map((s) => (
            <li class="stk-row" data-symbol={s}>
              <span class="stk-sym">{s}</span>
              <span class="stk-name">—</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="stk-group">
        <p class="stk-group-name">{b.portfolio}</p>
        <ul class="stk-list stk-portfolio" data-stk-list="portfolio">
          {PORTFOLIO.map((p) => (
            <li class="stk-row" data-symbol={p.symbol} data-label={p.label}>
              <span class="stk-sym">{p.label}</span>
              <span class="stk-name">—</span>
            </li>
          ))}
        </ul>
        <div class="stk-totals" data-stk-totals hidden></div>
      </div>
    </div>
    <p class="stk-note" data-stk-note>{b.lead}</p>
  </div>
  <div class="stk-main" data-stk-main>
    <button class="stk-back" type="button" data-stk-back><Icon id="ui-chevron" size={14} />{b.list}</button>
    <div class="stk-empty"><Icon id="bolsa" size={44} /><p>{b.pick}</p></div>
  </div>
</section>
