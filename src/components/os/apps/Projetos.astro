---
import { SITE, COPY, type Lang } from '../../../siteConfig';
import Icon from '../Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = COPY[lang];
const p = c.projetos;
---
<section class="app-shell app-projetos relative flex min-h-0 flex-col overflow-hidden bg-(--surface-solid)" data-content="projetos" aria-label={c.apps.projetos.name}>
  <div class="app-scroll min-h-0 flex-1 overflow-auto [-webkit-overflow-scrolling:touch]">
    <div class="app-pad px-7.5 pb-8.5 pt-6.5 [[data-mode='ios']_&]:px-5 [[data-mode='ios']_&]:pb-7 [[data-mode='ios']_&]:pt-5">
      <h2 class="app-title font-(family-name:--display) m-0 mb-1.5 text-[26px] leading-[1.12] tracking-[-0.024em] font-bold [[data-mode='ios']_&]:text-[length:var(--t-large)]">{c.apps.projetos.name}</h2>
      <p class="app-lead mb-5.5 max-w-[56ch] text-[15px] text-(--ink-2)">{p.lead}</p>
      <div class="cards grid grid-cols-[repeat(auto-fill,minmax(250px,1fr))] gap-3.5 [[data-mode='ios']_&]:grid-cols-1">
        {p.list.map((item) => (
          <article class="card flex flex-col gap-2 border-[0.5px] border-(--line) bg-(--surface-2) p-4.5">
            <h3 class="m-0 text-[16px] tracking-[-0.015em]">{item.name}</h3>
            <p class="tagline m-0 text-[12px] font-medium text-(--accent)">{item.tagline}</p>
            <p class="m-0 text-[13px] leading-[1.5] text-(--ink-2)">{item.body}</p>
            <p class="chips mt-auto flex flex-wrap gap-1.5 pt-1.5">{item.tags.map((t) => <span class="chip inline-block rounded-full bg-(--surface-3) px-2.25 py-0.75 text-[11px] text-(--ink-2)">{t}</span>)}</p>
          </article>
        ))}
      </div>
      <div class="btn-row mt-4.5 flex flex-wrap gap-2.5">
        <a class="btn btn-primary" href={SITE.github} target="_blank" rel="noopener">
          <Icon id="ui-arrow" size={12} />{p.all}
        </a>
      </div>
    </div>
  </div>
</section>
