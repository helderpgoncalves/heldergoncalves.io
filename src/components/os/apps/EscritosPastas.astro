---
// A coluna de pastas das Notas reais — aqui, "Todos os Escritos" mais
// uma pasta por tema (as tags que os escritos já têm). Clicar filtra a
// lista do meio, tal como uma pasta real filtra notas — ver o listener
// em escritos.js. Como numa lista de fontes do macOS: um cabeçalho de
// secção pequeno, e cada linha com o ícone na cor da aplicação.
import Icon from '../Icon.astro';
interface Folder { id: string; label: string; count: number }
interface Props { folders: Folder[]; heading: string; drafts: string }
const { folders, heading, drafts } = Astro.props;
---
<nav class="notes-folders flex-none basis-[190px] overflow-auto border-r-[0.5px] border-(--line) bg-transparent py-2 @max-[820px]/app:hidden" aria-label={heading}>
  <p class="m-0 px-4.5 pb-1 pt-1.5 text-[length:var(--t-subhead,11px)] font-semibold text-(--ink-3)">{heading}</p>
  <ul class="m-0 list-none p-0 px-2">
    {folders.map((f, i) => (
      <li>
        <button
          class="folder-item flex w-full items-center gap-2 px-2.5 py-1.25 text-left text-[length:var(--t-body,13px)] text-(--ink) transition-colors duration-120 hover:bg-(--surface-2) aria-current:bg-(--surface-3) aria-current:text-(--accent) aria-current:font-medium [&_svg]:h-4 [&_svg]:w-4 [&_svg]:flex-none [&_svg]:text-(--accent)"
          type="button"
          data-folder={f.id}
          aria-current={i === 0 ? 'true' : undefined}
        >
          <Icon id={i === 0 ? 'ui-note' : 'ui-folder'} />
          <span class="min-w-0 flex-1 overflow-hidden text-ellipsis whitespace-nowrap">{f.label}</span>
          <span class="folder-count flex-none text-[length:var(--t-caption,11px)] text-(--ink-3)">{f.count}</span>
        </button>
      </li>
    ))}
    {/* Só o dono vê esta pasta — escritos-editor.js marca a app com
        data-owner quando a sessão é a dele. */}
    <li class="hidden group-data-[owner='1']:block">
      <button
        class="folder-item flex w-full items-center gap-2 px-2.5 py-1.25 text-left text-[length:var(--t-body,13px)] text-(--ink) transition-colors duration-120 hover:bg-(--surface-2) aria-current:bg-(--surface-3) aria-current:text-(--accent) aria-current:font-medium [&_svg]:h-4 [&_svg]:w-4 [&_svg]:flex-none [&_svg]:text-(--accent)"
        type="button"
        data-folder="rascunhos"
      >
        <Icon id="ui-compose" />
        <span class="min-w-0 flex-1 overflow-hidden text-ellipsis whitespace-nowrap">{drafts}</span>
        <span class="folder-count flex-none text-[length:var(--t-caption,11px)] text-(--ink-3)" data-drafts-count>0</span>
      </button>
    </li>
  </ul>
</nav>
