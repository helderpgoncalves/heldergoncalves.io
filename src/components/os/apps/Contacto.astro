---
// Mail — a app da Apple, com duas caras (como as Mensagens).
//
//   Visitante com sessão: a folha de escrever do iOS, que é o que
//         sempre esteve aqui — campos em filas com um fio entre elas, o
//         corpo por baixo, e a barra de enviar sempre à vista.
//   Dono: a caixa de entrada. Quem lhe escreveu, a conversa de cada um,
//         e um compositor de resposta com um botão que redige um
//         rascunho. O dono não se escreve a si próprio — `/api/contact`
//         responde 403 `proprio` à sessão dele, e deste lado a folha de
//         escrever nem aparece.
//
// A forma da caixa de entrada (as linhas com ponto azul, os dois ecrãs
// quando o contentor é estreito) está em styles/os/mail.css.
//
// A armadilha que isto já teve: a secção rolava E o formulário era
// `flex-1` com o corpo `flex-1` lá dentro. Dois contentores a disputar
// a mesma altura davam o que se via no telefone — o corpo, os botões e
// os links uns por cima dos outros. Agora há **um** sítio que rola (o
// miolo) e uma barra que não rola, e uma coisa não pode cair em cima da
// outra por construção.
import { SITE, COPY, socialLinks, type Lang } from '../../../siteConfig';
import Icon from '../Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = COPY[lang];
const k = c.contacto;
const links = socialLinks(lang).filter((l) => l.id !== 'email');
const w = c.mail;

// A fila de um campo: o rótulo em cinzento e o valor a seguir, com o
// fio por baixo — a medida da Mail do iOS, não uma grelha de formulário.
const FILA = 'compose-field flex items-baseline gap-2 border-b-[0.5px] border-(--line) px-4 py-2.5';
const ROTULO = 'flex-none text-[length:var(--t-callout)] text-(--ink-3)';
const CAMPO =
  'min-w-0 flex-1 border-0 bg-transparent text-[length:var(--t-callout)] text-(--ink) outline-hidden placeholder:text-(--ink-3) read-only:text-(--ink-2)';
---
<section class="app-shell app-contacto flex-col bg-(--surface-solid)" data-content="contacto" aria-label={c.apps.contacto.name}>
  {/* ── A caixa de entrada, só do dono ─────────────────────────────
      Nasce escondida e o JavaScript revela-a depois de confirmar
      `amIOwner()`. Vem vazia de propósito: o conteúdo é de
      /api/mail, que o backend já recusa a quem não é o dono — não há
      aqui nada que um visitante possa ver na origem da página. */}
  <aside class="mail-list-pane" data-mail-sidebar hidden aria-hidden="true">
    <div class="mail-list-head">
      <h2>{w.inbox}</h2>
      <p class="mail-list-count m-0" data-mail-count>{w.allRead}</p>
    </div>
    <ul class="mail-list" data-mail-list aria-label={w.inbox}></ul>
    <div class="mail-empty" data-mail-empty hidden>
      <span class="mail-empty-icon" aria-hidden="true"><Icon id="ui-mail" size={24} /></span>
      <p class="m-0">{w.empty}</p>
    </div>
  </aside>

  {/* ── A conversa de uma pessoa, e a resposta ─────────────────── */}
  <div class="mail-thread" data-mail-thread hidden>
    {/* O vazio do dono, antes de escolher alguém. Vive DENTRO da
        conversa, e não ao lado dela, por causa do ecrã estreito: aí a
        conversa entra a deslizar por cima da lista, e um painel que
        aparece e desaparece por `hidden` não desliza — some. */}
    <div class="mail-empty" data-mail-pick hidden>
      <span class="mail-empty-icon" aria-hidden="true"><Icon id="ui-note" size={24} /></span>
      <p class="m-0">{w.pick}</p>
    </div>

    <header class="mail-thread-head" data-mail-head hidden>
      <button class="mail-back" type="button" data-mail-back>
        <Icon id="ui-chevron" size={13} />{w.inbox}
      </button>
      <span class="mail-avatar" data-mail-avatar aria-hidden="true"></span>
      <span class="mail-who">
        <strong data-mail-name></strong>
        <span data-mail-to></span>
      </span>
    </header>

    <div class="mail-scroll min-h-0 flex-1 overflow-auto" data-mail-scroll hidden>
      <h3 class="mail-subject" data-mail-subject></h3>
      <div class="mail-messages" data-mail-messages></div>
    </div>

    {/* O rascunho entra no campo para ser EDITADO — nunca sai daqui
        sozinho. Quem carrega em enviar é o Hélder, depois de o ler. */}
    <form class="mail-reply" data-mail-reply novalidate hidden>
      <textarea
        class="mail-reply-body field-sizing-content w-full resize-none border-0 bg-transparent text-[length:var(--t-body)] leading-[1.5] text-(--ink) outline-hidden placeholder:text-(--ink-3)"
        data-mail-text
        placeholder={w.replyPlaceholder}
        rows="3"
        maxlength="4000"></textarea>
      <div class="mail-reply-acts">
        <button class="btn" type="button" data-mail-draft>{w.draft}</button>
        <p class="mail-reply-hint m-0 min-w-0 flex-1 truncate text-[length:var(--t-caption)] text-(--ink-3) data-[tone=warn]:text-(--orange) data-[tone=ok]:text-(--green)" data-mail-hint role="status" aria-live="polite"></p>
        <button class="mail-send" type="submit" aria-label={w.send}>
          <Icon id="ui-arrow" size={15} />
        </button>
      </div>
    </form>
  </div>

  <form class="compose flex min-h-0 flex-1 flex-col" data-compose novalidate action={`mailto:${SITE.email}`} method="post" enctype="text/plain">
    {/* O cabeçalho é o da Mail a sério, e é diferente nos dois sistemas
        porque as duas apps são diferentes: no telefone uma folha, com o
        título grande por baixo dos botões; no Mac uma barra de
        ferramentas fina, com o enviar à esquerda — o título já está na
        barra da janela e não se repete. */}
    <header class="compose-head flex flex-none items-center gap-2.5 border-b-[0.5px] border-(--line) px-4 py-2.5 [[data-mode='ios']_&]:flex-col [[data-mode='ios']_&]:items-stretch [[data-mode='ios']_&]:gap-2 [[data-mode='ios']_&]:px-5 [[data-mode='ios']_&]:pb-3 [[data-mode='ios']_&]:pt-1">
      <div class="compose-acts flex items-center gap-2.5 [[data-mode='ios']_&]:flex-row-reverse">
        <button class="compose-send grid h-8 w-8 flex-none place-items-center rounded-full bg-(--accent) text-(--accent-ink) transition-[filter,transform] duration-150 hover:brightness-110 active:scale-94 [&_svg]:-rotate-90" type="submit" aria-label={k.send}>
          <Icon id="ui-arrow" size={15} />
        </button>
        <button class="btn mr-auto" type="button" data-copy-email>{k.copy}</button>
      </div>
      {/* Só no telefone: no Mac o título vive na barra da janela. */}
      <h2 class="compose-title m-0 hidden font-(--display) text-[length:var(--t-title)] font-bold tracking-[-0.02em] [[data-mode='ios']_&]:block">{c.apps.contacto.window}</h2>
    </header>

    {/* O aviso fica numa linha sua, a toda a largura: dentro do
        cabeçalho era cortado, e as frases que importam — «entra
        primeiro», «não consegui enviar» — são precisamente as compridas.
        A cor vem do tom que contacto.js escreve. */}
    <p
      class="compose-hint m-0 flex-none px-4 pb-2 text-[length:var(--t-caption)] leading-[1.4] text-(--ink-3) data-[tone=warn]:text-(--orange) data-[tone=ok]:text-(--green)"
      data-compose-hint
      role="status"
      aria-live="polite"
    >{k.sendHint}</p>

    {/* O único sítio que rola. */}
    <div class="compose-scroll min-h-0 flex-1 overflow-auto">
      <div class="compose-fields flex-none">
        <div class={FILA}>
          <label class={ROTULO} for="c-to">{k.to}</label>
          <input class={CAMPO} id="c-to" name="to" value={SITE.email} readonly />
        </div>
        {/* O «De» é o email da sessão e fecha-se quando há uma (ver
            contacto.js): o servidor ignora este campo e assina sempre
            com quem entrou. Sem sessão fica livre, porque aí o caminho
            é o `mailto:` do próprio cliente de correio. */}
        <div class={FILA}>
          <label class={ROTULO} for="c-from">{k.from}</label>
          <input class={CAMPO} id="c-from" name="from" type="email" placeholder="tu@exemplo.com" autocomplete="email" required />
        </div>
        <div class={FILA}>
          <label class={ROTULO} for="c-subject">{k.subject}</label>
          <input class={CAMPO} id="c-subject" name="subject" value={k.subjectValue} />
        </div>
      </div>

      <div class="hp" aria-hidden="true">
        <label for="c-company">{k.honeypot}</label>
        <input id="c-company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      {/* Cresce com o que se escreve, em vez de disputar a altura com o
          resto — é `field-sizing-content`, o mesmo do editor do Blog. */}
      <label class="sr" for="c-body">{k.body}</label>
      <textarea
        class="compose-body field-sizing-content min-h-[180px] w-full resize-none border-0 bg-transparent px-4 py-3.5 text-[length:var(--t-body)] leading-[1.55] text-(--ink) outline-hidden placeholder:text-(--ink-3)"
        id="c-body"
        name="body"
        placeholder={k.placeholder}
        rows="8"
        required
        minlength="10"></textarea>

      {/* Noutros sítios: um grupo arredondado por baixo do corpo, como
          as fileiras das Definições. Rola com o resto — não é uma
          camada por cima de nada. */}
      <div class="compose-intro px-4 pb-7 pt-2">
        <h3 class="m-0 mb-1.5 px-1 text-[length:var(--t-caption)] uppercase tracking-[0.08em] text-(--ink-3)">{k.elsewhere}</h3>
        <div class="rows overflow-hidden border-[0.5px] border-(--line) bg-(--surface-2)">
          {links.map((l) => (
            <a class="row flex w-full items-center gap-3 border-b-[0.5px] border-(--line) px-3.5 py-2.75 text-left text-inherit no-underline last:border-b-0 hover:bg-(--surface-3) hover:no-underline" href={l.href} target="_blank" rel="noopener me">
              <span class="min-w-0 flex-1 truncate text-[length:var(--t-subhead)] text-(--ink-3)">{l.label}</span>
              <span class="min-w-0 truncate text-right text-[length:var(--t-subhead)] text-(--ink)">{l.value}</span>
              <Icon id={`ui-${l.id}`} class="flex-none text-(--ink-3)" size={15} />
            </a>
          ))}
        </div>
      </div>
    </div>
  </form>
</section>
