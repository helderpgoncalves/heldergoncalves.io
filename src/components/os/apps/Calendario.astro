---
// O Calendário. Sem JavaScript é uma explicação do que se pode marcar e
// um email para o fazer; com JavaScript é o mês, os horários livres e
// a marcação — depois de se entrar com o código.
import { SITE, COPY, type Lang } from '../../../siteConfig';
import Icon from '../Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = COPY[lang];
const k = c.calendario;
---
<section class="app-shell app-calendario" data-content="calendario" aria-label={c.apps.calendario.name}>
  <div class="cal-toolbar">
    <div class="seg cal-views" role="tablist">
      <button type="button" data-cal-view="month" aria-pressed="true">{k.month}</button>
      <button type="button" data-cal-view="day" aria-pressed="false">{k.day}</button>
    </div>
    <div class="cal-nav">
      <button type="button" class="cal-arrow" data-cal-prev aria-label={k.prev}><Icon id="ui-chevron" size={14} /></button>
      <button type="button" class="cal-today" data-cal-today>{k.today}</button>
      <button type="button" class="cal-arrow flip" data-cal-next aria-label={k.next}><Icon id="ui-chevron" size={14} /></button>
    </div>
    <div class="cal-session" data-cal-session></div>
  </div>

  <div class="cal-body">
    <div class="cal-month">
      <h2 class="cal-title" data-cal-title></h2>
      <div class="cal-week" data-cal-week></div>
      <div class="cal-grid" data-cal-grid role="grid"></div>
    </div>
    <aside class="cal-side" data-cal-side>
      <p class="cal-lead">{k.lead}</p>
      <p class="cal-lead"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </aside>
  </div>

  <div class="cal-sheet" data-cal-sheet hidden>
    <form class="cal-form" data-cal-book>
      <h3>{k.bookTitle}</h3>
      <p class="cal-when" data-cal-when></p>
      <label>{k.titleLabel}<input type="text" name="title" maxlength="160" placeholder={k.titlePlaceholder} autocomplete="off" /></label>
      <label>{k.noteLabel}<textarea name="note" rows="3" maxlength="1000" placeholder={k.notePlaceholder}></textarea></label>
      <p class="cal-hint" data-cal-hint></p>
      <div class="btn-row">
        <button class="btn" type="button" data-cal-close>{k.cancel}</button>
        <button class="btn btn-primary" type="submit">{k.confirm}</button>
      </div>
    </form>
  </div>
</section>
