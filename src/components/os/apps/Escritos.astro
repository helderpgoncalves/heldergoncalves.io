---
import { render } from 'astro:content';
import { SITE, COPY, ROUTES, formatDate, readingMinutes, type Lang } from '../../../siteConfig';
import { postPath, postSlug, type Post } from '../../../lib/posts';
import Icon from '../Icon.astro';
import EscritosPastas from './EscritosPastas.astro';

interface Props { lang: Lang; posts: Post[]; post?: Post; altPath?: string }
const { lang, posts, post, altPath } = Astro.props;
const c = COPY[lang];
const e = c.escritos;
const Content = post ? (await render(post)).Content : null;
const iso = (d: Date) => d.toISOString().slice(0, 10);

// Como as Notas: o que já não é de hoje agrupa-se por mês. As datas
// são fixas, por isso a conta faz-se no build e não muda depois.
const monthFmt = new Intl.DateTimeFormat(c.intlLocale, { month: 'long', year: 'numeric' });
const groups: { label: string; posts: Post[] }[] = [];
for (const p of posts) {
  const raw = monthFmt.format(p.data.date);
  const label = raw.charAt(0).toUpperCase() + raw.slice(1);
  const last = groups[groups.length - 1];
  if (last && last.label === label) last.posts.push(p);
  else groups.push({ label, posts: [p] });
}

// A coluna de pastas: "Todos os Escritos" mais uma por tema. As tags já
// existem no frontmatter — não é preciso um campo novo.
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const folders = [
  { id: 'all', label: e.allFolders, count: posts.length },
  ...allTags.map((tag) => ({ id: tag, label: tag, count: posts.filter((p) => p.data.tags.includes(tag)).length })),
];
---
<section
  class="app-shell app-escritos group flex-col bg-transparent"
  data-content="escritos"
  data-detail={post ? '1' : '0'}
  aria-label={c.apps.escritos.name}
>
  {/* A barra das Notas do Mac. `data-win-toolbar` faz a janela subi-la
      para a barra de título, ao lado dos semáforos (mac/windows.js) —
      é a barra unificada do macOS. No telefone não aparece. */}
  <div class="notes-toolbar flex min-w-0 flex-1 items-center gap-1 self-stretch [[data-mode='ios']_&]:hidden" data-win-toolbar>
    <button class="notes-tool grid h-7 w-8 place-items-center text-(--ink-2) transition-colors duration-120 hover:bg-(--surface-3) [&_svg]:h-4.5 [&_svg]:w-4.5" type="button" data-notes-sidebar aria-label={e.sidebar}><Icon id="ui-sidebar" /></button>
    <span class="spacer flex-1"></span>
    <button class="notes-tool grid h-7 w-8 place-items-center text-(--accent) transition-colors duration-120 hover:bg-(--surface-3) [&_svg]:h-4.5 [&_svg]:w-4.5" type="button" data-action="mail" aria-label={e.compose}><Icon id="ui-compose" /></button>
    <button class="notes-tool grid h-7 w-8 place-items-center text-(--ink-2) transition-colors duration-120 hover:bg-(--surface-3) [&_svg]:h-4.5 [&_svg]:w-4.5" type="button" data-action="share" aria-label={e.share}><Icon id="ui-share" /></button>
    <label class="notes-search ml-1 flex h-7 w-[150px] max-w-[40%] items-center gap-1.5 rounded-full border-[0.5px] border-(--line) bg-(--surface-2) px-2 text-(--ink-3) transition-[border-color,width] duration-150 focus-within:w-[220px] focus-within:border-(--accent) [&_svg]:h-3.25 [&_svg]:w-3.25 [&_svg]:flex-none">
      <Icon id="ui-search" />
      <span class="sr">{e.search}</span>
      <input type="search" placeholder={e.search} autocomplete="off" data-notes-search class="min-w-0 flex-1 border-0 bg-transparent text-[length:var(--t-body)] text-(--ink) outline-hidden placeholder:text-(--ink-3) [&::-webkit-search-cancel-button]:appearance-none" />
    </label>
  </div>

  <div class="notes-panes flex min-h-0 flex-1 flex-row @max-[640px]/app:flex-col">
  <EscritosPastas folders={folders} heading={e.folders} />
  <div class="app-side flex min-w-0 flex-none basis-[268px] flex-col border-r-[0.5px] border-(--line) bg-transparent [[data-mode='ios']_&]:border-r-0 [[data-mode='ios']_&]:bg-(--surface-2) @max-[640px]/app:flex-1 @max-[640px]/app:border-r-0 @max-[640px]/app:bg-transparent @min-[900px]/app:basis-[320px]">
    <div class="app-side-head border-b-[0.5px] border-(--line) px-4 pb-2.5 pt-3.5 [[data-mode='ios']_&]:border-b-0 [[data-mode='ios']_&]:px-4 [[data-mode='ios']_&]:pb-1.5 [[data-mode='ios']_&]:pt-1">
      <h2 class="m-0 text-[17px] tracking-[-0.02em] [[data-mode='ios']_&]:text-[length:var(--t-large)] [[data-mode='ios']_&]:font-bold [[data-mode='ios']_&]:tracking-[-0.02em]">{e.heading}</h2>
      <p class="m-0 mt-0.5 text-[12px] text-(--ink-3) [[data-mode='ios']_&]:hidden">{posts.length} {e.count} · <a href={ROUTES[lang].feed}>{c.labels.rss}</a></p>
    </div>
    <label class="notes-search notes-search-ios hidden [[data-mode='ios']_&]:mx-4 [[data-mode='ios']_&]:mb-1.5 [[data-mode='ios']_&]:flex [[data-mode='ios']_&]:h-9 [[data-mode='ios']_&]:items-center [[data-mode='ios']_&]:gap-1.5 [[data-mode='ios']_&]:rounded-full [[data-mode='ios']_&]:border-0 [[data-mode='ios']_&]:bg-(--surface-3) [[data-mode='ios']_&]:px-2.5 [[data-mode='ios']_&]:text-(--ink-3) [[data-mode='ios']_&]:[&_svg]:h-3.25 [[data-mode='ios']_&]:[&_svg]:w-3.25 [[data-mode='ios']_&]:[&_svg]:flex-none">
      <Icon id="ui-search" />
      <span class="sr">{e.search}</span>
      <input type="search" placeholder={e.search} autocomplete="off" data-notes-search class="min-w-0 flex-1 border-0 bg-transparent text-[length:var(--t-body)] text-(--ink) outline-hidden placeholder:text-(--ink-3) [[data-mode='ios']_&]:-my-1 [[data-mode='ios']_&]:min-h-11 [&::-webkit-search-cancel-button]:appearance-none" />
    </label>
    {posts.length === 0 ? (
      <p class="app-pad">{e.empty}</p>
    ) : (
      <ul class="post-list m-0 min-h-0 flex-1 list-none overflow-auto px-2 py-1.5 [[data-mode='ios']_&]:px-4">
        {groups.map((g) => (
          <li class="post-group list-none [&[hidden]]:hidden">
            <h4 class="m-0 px-2.5 pb-0.75 pt-2.5 text-[length:var(--t-subhead,11px)] font-semibold text-(--ink-3) [[data-mode='ios']_&]:px-0 [[data-mode='ios']_&]:pb-1.5 [[data-mode='ios']_&]:pt-3.5 [[data-mode='ios']_&]:text-[length:var(--t-title3)] [[data-mode='ios']_&]:font-bold [[data-mode='ios']_&]:text-(--ink)">{g.label}</h4>
            <ul class="m-0 list-none p-0 [[data-mode='ios']_&]:bg-(--surface-2) [[data-mode='ios']_&]:overflow-hidden">
              {g.posts.map((p) => (
                <li class="[&[hidden]]:hidden">
                  <a
                    class="post-link relative grid w-full gap-px px-2.5 py-1.75 text-left text-inherit no-underline before:absolute before:left-2.5 before:right-2.5 before:top-[-0.5px] before:h-[0.5px] before:bg-(--line) before:content-[''] first:before:content-none hover:bg-(--surface-3) hover:no-underline hover:before:opacity-0 aria-current:bg-(--notes-select) aria-current:text-(--notes-select-ink) aria-current:before:opacity-0 aria-current:[&_.post-sub]:text-(--notes-select-ink) aria-current:[&_.post-sub]:opacity-75 aria-current:[&_.post-sub_time]:text-(--notes-select-ink) [[data-mode='ios']_&]:gap-0.5 [[data-mode='ios']_&]:px-4 [[data-mode='ios']_&]:py-2.5 [[data-mode='ios']_&]:before:left-4 [[data-mode='ios']_&]:before:right-0 [[data-mode='ios']_&]:aria-current:bg-(--surface-3) [[data-mode='ios']_&]:aria-current:text-(--ink) [[data-mode='ios']_&]:aria-current:[&_.post-sub]:text-(--ink-3) [[data-mode='ios']_&]:aria-current:[&_.post-sub]:opacity-100 [[data-mode='ios']_&]:aria-current:[&_.post-sub_time]:text-(--ink-3)"
                    href={postPath(p, lang)}
                    data-post={postSlug(p)}
                    data-tags={p.data.tags.join('|')}
                    aria-current={post && postSlug(post) === postSlug(p) ? 'true' : undefined}
                  >
                    <h3 class="m-0 overflow-hidden text-ellipsis whitespace-nowrap text-[length:var(--t-headline,13px)] font-semibold tracking-[-0.01em] [[data-mode='ios']_&]:text-[length:var(--t-headline)]">{p.data.title}</h3>
                    {/* Como nas Notas: o título numa linha, e por baixo a
                        data e o princípio do texto na mesma linha, cortados
                        onde acabar a coluna. */}
                    <span class="post-sub flex min-w-0 items-baseline gap-1.5 overflow-hidden whitespace-nowrap text-[length:var(--t-foot,11px)] text-(--ink-3) [[data-mode='ios']_&]:text-[length:var(--t-subhead)]">
                      <time datetime={iso(p.data.date)} class="flex-none text-(--ink-2)">{formatDate(p.data.date, lang)}</time>
                      <span class="post-preview min-w-0 overflow-hidden text-ellipsis">{p.data.description}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
        <li class="notes-empty px-2.5 py-5 text-center text-[length:var(--t-foot,11px)] text-(--ink-3) [&[hidden]]:hidden" data-notes-empty hidden>{e.noMatch}</li>
      </ul>
    )}

    {/* Subscrever. O campo escondido é a armadilha para robôs: fica fora
        do ecrã e fora da ordem de tabulação, e só um robô o preenche.
        Se o servidor não tiver o envio ligado, o JavaScript esconde
        isto — melhor não haver campo do que haver um que não faz nada. */}
    <form class="sub flex-none border-t-[0.5px] border-(--line) bg-(--surface-2) px-3.5 pb-3.5 pt-3 [&[hidden]]:hidden" data-subscribe>
      <p class="sub-title m-0 mb-2 text-[length:var(--t-foot,11px)] font-semibold text-(--ink-2)">{e.subscribeTitle}</p>
      <div class="sub-row flex items-center gap-1.5 rounded-full border-[0.5px] border-(--line) bg-(--surface-solid) py-0.75 pl-3 pr-0.75 transition-[border-color] duration-150 focus-within:border-(--accent)">
        <label class="sr" for="sub-email">{e.subscribeLabel}</label>
        <input
          id="sub-email"
          class="sub-input min-w-0 flex-1 border-0 bg-transparent text-[length:var(--t-foot,12px)] text-(--ink) outline-hidden placeholder:text-(--ink-3) [[data-mode='ios']_&]:text-[length:var(--t-subhead)]"
          type="email"
          name="email"
          autocomplete="email"
          placeholder={e.subscribePlaceholder}
          required
          data-subscribe-email
        />
        <button class="sub-go flex-none rounded-full bg-(--accent) px-3.5 py-1.5 text-[length:var(--t-caption,11px)] font-[590] text-(--accent-ink) transition-[opacity,transform] duration-150 active:scale-96 [form[data-busy='1']_&]:pointer-events-none [form[data-busy='1']_&]:opacity-50 [[data-mode='ios']_&]:min-h-9 [[data-mode='ios']_&]:text-[length:var(--t-foot)]" type="submit">{e.subscribeAction}</button>
      </div>
      <input class="sr" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" data-subscribe-trap />
      <p class="sub-note m-0 mt-2 text-[length:var(--t-caption,11px)] leading-[1.4] text-(--ink-3) data-[tone=good]:text-(--green) data-[tone=bad]:text-(--danger)" data-subscribe-note>{e.subscribeNote}</p>
    </form>
    <div class="notes-foot hidden [[data-mode='ios']_&]:grid [[data-mode='ios']_&]:flex-none [[data-mode='ios']_&]:grid-cols-[44px_1fr_44px] [[data-mode='ios']_&]:items-center [[data-mode='ios']_&]:border-t-[0.5px] [[data-mode='ios']_&]:border-(--line) [[data-mode='ios']_&]:bg-(--surface) [[data-mode='ios']_&]:px-3 [[data-mode='ios']_&]:py-1.5 [[data-mode='ios']_&]:backdrop-blur-(--blur)">
      <span class="count col-start-2 text-center text-[length:var(--t-caption2)] text-(--ink-2)">{posts.length} {e.count}</span>
      <button class="notes-tool col-start-3 grid h-11 w-11 place-items-center text-(--accent) [&_svg]:h-5.5 [&_svg]:w-5.5" type="button" data-action="mail" aria-label={e.compose}><Icon id="ui-compose" /></button>
    </div>
  </div>

  <div class="app-main flex min-w-0 flex-1 flex-col bg-(--surface-solid) [&.dragging]:!transition-none [&.dragging]:visible [&.dragging]:shadow-[-14px_0_34px_rgba(0,0,0,0.22)] @max-[640px]/app:absolute @max-[640px]/app:inset-0 @max-[640px]/app:z-3 @max-[640px]/app:translate-x-full @max-[640px]/app:invisible @max-[640px]/app:transition-transform @max-[640px]/app:duration-[0.34s] @max-[640px]/app:ease-(--ease-os) @max-[640px]/app:group-data-[detail='1']:translate-x-0 @max-[640px]/app:group-data-[detail='1']:visible">
    <button class="back-btn hidden items-center gap-1 px-4 pt-2.5 text-[15px] text-(--accent) @max-[640px]/app:inline-flex" type="button" data-back-list>
      <Icon id="ui-chevron" size={12} />{e.backToList}
    </button>
    <div class="app-scroll" data-reader>
      {post && Content ? (
        <article class="app-pad prose" data-post-body={postSlug(post)}>
          <header class="article-head">
            <p class="app-eyebrow mb-3.5 text-center text-[length:var(--t-subhead)] text-(--ink-3)">
              <time datetime={iso(post.data.date)}>{formatDate(post.data.date, lang)}</time>
              · {readingMinutes(post.body)} {e.readingTime}
            </p>
            <h1>{post.data.title}</h1>
            <p>{post.data.description}</p>
            {post.data.updated && (
              <p class="post-meta text-[11px] text-(--ink-3)">{e.updated} <time datetime={iso(post.data.updated)}>{formatDate(post.data.updated, lang)}</time></p>
            )}
            {altPath && <p class="post-meta text-[11px] text-(--ink-3)"><a href={altPath}>{e.readOther} →</a></p>}
          </header>
          <Content />
          <footer class="article-foot">
            {post.data.tags.length > 0 && (
              <p class="chips">{post.data.tags.map((t) => <span class="chip">{t}</span>)}</p>
            )}
            <p>{e.talk} <a href={`mailto:${SITE.email}?subject=${encodeURIComponent(post.data.title)}`}>{e.talkLink}</a></p>
          </footer>

          {/* Preenchido por comentarios.js depois de cada troca de escrito —
              sem JavaScript, fica só o convite a comentar por email acima. */}
          <section class="comments mt-8.5 border-t border-(--line) pt-4.5" data-comments={postSlug(post)}>
            <h2 class="comments-heading m-0 mb-3.5 text-[length:var(--t-title3)]">{e.comments.heading}</h2>
            <div class="comments-reactions mb-5 flex flex-wrap gap-2" data-comments-reactions role="group" aria-label={e.comments.heading}>
              <button type="button" class="reaction inline-flex items-center gap-1.5 rounded-full border-[0.5px] border-(--line) bg-(--surface-solid) px-3 py-1.5 text-[length:var(--t-caption)] text-(--ink-2) transition-[background,border-color] duration-150 hover:bg-(--surface-2) aria-pressed:border-(--accent) aria-pressed:text-(--accent) aria-pressed:bg-(--surface-3) [&_.reaction-count]:aria-pressed:text-(--accent)" data-reaction="gosto">
                <span aria-hidden="true">👍</span> {e.comments.reactGosto}
                <span class="reaction-count tabular-nums text-(--ink-3)" data-reaction-count>0</span>
              </button>
              <button type="button" class="reaction inline-flex items-center gap-1.5 rounded-full border-[0.5px] border-(--line) bg-(--surface-solid) px-3 py-1.5 text-[length:var(--t-caption)] text-(--ink-2) transition-[background,border-color] duration-150 hover:bg-(--surface-2) aria-pressed:border-(--accent) aria-pressed:text-(--accent) aria-pressed:bg-(--surface-3) [&_.reaction-count]:aria-pressed:text-(--accent)" data-reaction="adorei">
                <span aria-hidden="true">❤️</span> {e.comments.reactAdorei}
                <span class="reaction-count tabular-nums text-(--ink-3)" data-reaction-count>0</span>
              </button>
              <button type="button" class="reaction inline-flex items-center gap-1.5 rounded-full border-[0.5px] border-(--line) bg-(--surface-solid) px-3 py-1.5 text-[length:var(--t-caption)] text-(--ink-2) transition-[background,border-color] duration-150 hover:bg-(--surface-2) aria-pressed:border-(--accent) aria-pressed:text-(--accent) aria-pressed:bg-(--surface-3) [&_.reaction-count]:aria-pressed:text-(--accent)" data-reaction="ideia">
                <span aria-hidden="true">💡</span> {e.comments.reactIdeia}
                <span class="reaction-count tabular-nums text-(--ink-3)" data-reaction-count>0</span>
              </button>
            </div>

            <ul class="comments-list m-0 mb-5 grid list-none gap-3.5 p-0" data-comments-list></ul>
            <p class="comments-empty m-0 mb-5 text-[length:var(--t-subhead)] text-(--ink-3) [&[hidden]]:hidden" data-comments-empty hidden>{e.comments.empty}</p>

            <form class="comments-form grid max-w-[44ch] gap-2 [&[hidden]]:hidden [&[data-busy='1']_.btn]:pointer-events-none [&[data-busy='1']_.btn]:opacity-50" data-comments-form>
              <p class="comments-form-title m-0 mb-1 text-[length:var(--t-foot,11px)] font-semibold text-(--ink-2)">{e.comments.formTitle}</p>
              <label class="sr" for="comment-body">{e.comments.placeholder}</label>
              <textarea id="comment-body" class="comments-textarea w-full resize-y border-[0.5px] border-(--line) bg-(--surface-solid) px-3 py-2.25 text-[length:var(--t-subhead)] text-(--ink) outline-hidden transition-[border-color] duration-150 focus:border-(--accent) min-h-[4.5em]" name="body" rows="3" maxlength="2000" placeholder={e.comments.placeholder} required data-comments-body></textarea>
              <input class="sr" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" data-comments-trap />
              <button class="btn btn-primary justify-self-start" type="submit">{e.comments.submit}</button>
              <p class="comments-hint m-0 min-h-[1.2em] text-[length:var(--t-caption,11px)] text-(--ink-3)" data-comments-hint></p>
            </form>
          </section>
        </article>
      ) : (
        <div class="app-main-empty flex-1 grid place-content-center justify-items-center gap-2 text-(--ink-3) [&_svg]:h-10.5 [&_svg]:w-10.5 [&_svg]:opacity-50">
          <Icon id="ui-note" size={42} />
          <p>{e.pick}</p>
        </div>
      )}
    </div>
  </div>
  </div>
</section>
