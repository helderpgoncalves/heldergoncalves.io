---
import { SITE, COPY, ROUTES, formatDate, readingMinutes, type Lang } from '../../../siteConfig';
import { postPath, postSlug, type Post } from '../../../lib/posts';
import Icon from '../Icon.astro';

interface Props { lang: Lang; posts: Post[]; post?: Post; altPath?: string }
const { lang, posts, post, altPath } = Astro.props;
const c = COPY[lang];
const e = c.escritos;
const Content = post ? (await post.render()).Content : null;
const iso = (d: Date) => d.toISOString().slice(0, 10);

// Como as Notas: o que já não é de hoje agrupa-se por mês. As datas
// são fixas, por isso a conta faz-se no build e não muda depois.
const monthFmt = new Intl.DateTimeFormat(c.intlLocale, { month: 'long', year: 'numeric' });
const groups: { label: string; posts: Post[] }[] = [];
for (const p of posts) {
  const raw = monthFmt.format(p.data.date);
  const label = raw.charAt(0).toUpperCase() + raw.slice(1);
  const last = groups[groups.length - 1];
  if (last && last.label === label) last.posts.push(p);
  else groups.push({ label, posts: [p] });
}
---
<section
  class="app-shell app-escritos"
  data-content="escritos"
  data-detail={post ? '1' : '0'}
  aria-label={c.apps.escritos.name}
>
  {/* A barra das Notas do Mac. No telefone não aparece. */}
  <div class="notes-toolbar">
    <button class="notes-tool" type="button" data-notes-sidebar aria-label={e.sidebar}><Icon id="ui-sidebar" /></button>
    <span class="spacer"></span>
    <button class="notes-tool" type="button" data-action="mail" aria-label={e.compose}><Icon id="ui-compose" /></button>
    <button class="notes-tool" type="button" data-action="share" aria-label={e.share}><Icon id="ui-share" /></button>
    <label class="notes-search">
      <Icon id="ui-search" />
      <span class="sr">{e.search}</span>
      <input type="search" placeholder={e.search} autocomplete="off" data-notes-search />
    </label>
  </div>

  <div class="notes-panes">
  <div class="app-side">
    <div class="app-side-head">
      <h2>{e.heading}</h2>
      <p>{posts.length} {e.count} · <a href={ROUTES[lang].feed}>{c.labels.rss}</a></p>
    </div>
    <label class="notes-search notes-search-ios">
      <Icon id="ui-search" />
      <span class="sr">{e.search}</span>
      <input type="search" placeholder={e.search} autocomplete="off" data-notes-search />
    </label>
    {posts.length === 0 ? (
      <p class="app-pad">{e.empty}</p>
    ) : (
      <ul class="post-list">
        {groups.map((g) => (
          <li class="post-group">
            <h4>{g.label}</h4>
            <ul>
              {g.posts.map((p) => (
                <li>
                  <a
                    class="post-link"
                    href={postPath(p, lang)}
                    data-post={postSlug(p)}
                    aria-current={post && postSlug(post) === postSlug(p) ? 'true' : undefined}
                  >
                    <h3>{p.data.title}</h3>
                    {/* Como nas Notas: o título numa linha, e por baixo a
                        data e o princípio do texto na mesma linha, cortados
                        onde acabar a coluna. */}
                    <span class="post-sub">
                      <time datetime={iso(p.data.date)}>{formatDate(p.data.date, lang)}</time>
                      <span class="post-preview">{p.data.description}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
        <li class="notes-empty" data-notes-empty hidden>{e.noMatch}</li>
      </ul>
    )}

    {/* Subscrever. O campo escondido é a armadilha para robôs: fica fora
        do ecrã e fora da ordem de tabulação, e só um robô o preenche.
        Se o servidor não tiver o envio ligado, o JavaScript esconde
        isto — melhor não haver campo do que haver um que não faz nada. */}
    <form class="sub" data-subscribe>
      <p class="sub-title">{e.subscribeTitle}</p>
      <div class="sub-row">
        <label class="sr" for="sub-email">{e.subscribeLabel}</label>
        <input
          id="sub-email"
          class="sub-input"
          type="email"
          name="email"
          autocomplete="email"
          placeholder={e.subscribePlaceholder}
          required
          data-subscribe-email
        />
        <button class="sub-go" type="submit">{e.subscribeAction}</button>
      </div>
      <input class="sr" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" data-subscribe-trap />
      <p class="sub-note" data-subscribe-note>{e.subscribeNote}</p>
    </form>
    <div class="notes-foot">
      <span class="count">{posts.length} {e.count}</span>
      <button class="notes-tool" type="button" data-action="mail" aria-label={e.compose}><Icon id="ui-compose" /></button>
    </div>
  </div>

  <div class="app-main">
    <button class="back-btn" type="button" data-back-list>
      <Icon id="ui-chevron" size={12} />{e.backToList}
    </button>
    <div class="app-scroll" data-reader>
      {post && Content ? (
        <article class="app-pad prose" data-post-body={postSlug(post)}>
          <header class="article-head">
            <p class="app-eyebrow">
              <time datetime={iso(post.data.date)}>{formatDate(post.data.date, lang)}</time>
              · {readingMinutes(post.body)} {e.readingTime}
            </p>
            <h1>{post.data.title}</h1>
            <p>{post.data.description}</p>
            {post.data.updated && (
              <p class="post-meta">{e.updated} <time datetime={iso(post.data.updated)}>{formatDate(post.data.updated, lang)}</time></p>
            )}
            {altPath && <p class="post-meta"><a href={altPath}>{e.readOther} →</a></p>}
          </header>
          <Content />
          <footer class="article-foot">
            {post.data.tags.length > 0 && (
              <p class="chips">{post.data.tags.map((t) => <span class="chip">{t}</span>)}</p>
            )}
            <p>{e.talk} <a href={`mailto:${SITE.email}?subject=${encodeURIComponent(post.data.title)}`}>{e.talkLink}</a></p>
          </footer>

          {/* Preenchido por comentarios.js depois de cada troca de escrito —
              sem JavaScript, fica só o convite a comentar por email acima. */}
          <section class="comments" data-comments={postSlug(post)}>
            <h2 class="comments-heading">{e.comments.heading}</h2>
            <div class="comments-reactions" data-comments-reactions role="group" aria-label={e.comments.heading}>
              <button type="button" class="reaction" data-reaction="gosto">
                <span aria-hidden="true">👍</span> {e.comments.reactGosto}
                <span class="reaction-count" data-reaction-count>0</span>
              </button>
              <button type="button" class="reaction" data-reaction="adorei">
                <span aria-hidden="true">❤️</span> {e.comments.reactAdorei}
                <span class="reaction-count" data-reaction-count>0</span>
              </button>
              <button type="button" class="reaction" data-reaction="ideia">
                <span aria-hidden="true">💡</span> {e.comments.reactIdeia}
                <span class="reaction-count" data-reaction-count>0</span>
              </button>
            </div>

            <ul class="comments-list" data-comments-list></ul>
            <p class="comments-empty" data-comments-empty hidden>{e.comments.empty}</p>

            <div class="comments-signin" data-comments-signin hidden>
              <p>{e.comments.signInFirst}</p>
              <button type="button" class="btn" data-action="entrar">{e.comments.signIn}</button>
            </div>

            <form class="comments-form" data-comments-form>
              <p class="comments-form-title">{e.comments.formTitle}</p>
              <label class="sr" for="comment-body">{e.comments.placeholder}</label>
              <textarea id="comment-body" class="comments-textarea" name="body" rows="3" maxlength="2000" placeholder={e.comments.placeholder} required data-comments-body></textarea>
              <input class="sr" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" data-comments-trap />
              <button class="btn btn-primary" type="submit">{e.comments.submit}</button>
              <p class="comments-hint" data-comments-hint></p>
            </form>
          </section>
        </article>
      ) : (
        <div class="app-main-empty">
          <Icon id="ui-note" size={42} />
          <p>{e.pick}</p>
        </div>
      )}
    </div>
  </div>
  </div>
</section>
