---
// Mensagens — a app da Apple, com duas caras.
//
//   Visitante com sessão: uma conversa só, com o assistente.
//   Dono: a lista de toda a gente que lhe escreveu, e cada conversa
//         para ler. O dono não fala consigo próprio — não há campo de
//         escrever nenhum do lado dele (ver mensagens.js e o 403 em
//         routers/chat.py).
//
// A forma (bolhas com cauda, agrupamento, os dois ecrãs quando o
// contentor é estreito) está em styles/os/mensagens.css.
import { SITE, COPY, type Lang } from '../../../siteConfig';
import Icon from '../Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = COPY[lang];
const m = c.mensagens;
---
<section class="app-shell app-mensagens" data-content="mensagens" aria-label={c.apps.mensagens.name}>
  {/* A lista de conversas — só existe para o dono. O JS revela-a
      depois de confirmar `amIOwner()`; o conteúdo vem de
      /api/mensagens, que o backend já recusa a quem não é o dono. */}
  <aside class="msg-list-pane glass bl-flutua" data-msg-sidebar hidden aria-hidden="true">
    <div class="msg-list-head">
      <h2>{m.inbox}</h2>
      <span class="msg-list-count" data-msg-count></span>
    </div>
    <label class="msg-search">
      <Icon id="ui-search" size={13} />
      <span class="sr">{m.search}</span>
      <input type="search" data-msg-search placeholder={m.search} autocomplete="off" />
    </label>
    <ul class="msg-conv-list" data-msg-conv-list aria-label={m.conversations}></ul>
    <div class="msg-empty" data-msg-conv-empty hidden>
      <span class="msg-empty-icon" aria-hidden="true"><Icon id="ui-mail" size={24} /></span>
      <p class="m-0">{m.noConversations}</p>
    </div>
  </aside>

  <div class="msg-thread bl-conteudo" data-msg-thread>
    <div class="msg-head">
      <button class="msg-back" type="button" data-msg-back>
        <Icon id="ui-chevron" size={13} />{m.inbox}
      </button>
      <span class="msg-avatar" data-chat-avatar aria-hidden="true"><Icon id="sobre" /></span>
      <div class="msg-id">
        <strong data-chat-title>{m.contactName}</strong>
        <span data-chat-subtitle>{m.status}</span>
      </div>
      <div class="msg-head-actions">
        <a class="btn" data-msg-reply href={`mailto:${SITE.email}`} hidden>{m.replyByMail}</a>
        <button class="btn" type="button" data-chat-reset>{m.restart}</button>
      </div>
    </div>

    <div class="msg-log" data-chat-log aria-live="polite">
      <p class="msg-stamp"><b>{c.os.today}</b></p>
      <div class="msg-row them">
        <p class="msg-b them grp-first tail">{m.opener}</p>
      </div>
    </div>

    {/* O dono, antes de escolher uma conversa. */}
    <div class="msg-empty" data-msg-pick hidden>
      <span class="msg-empty-icon" aria-hidden="true"><Icon id="ui-note" size={24} /></span>
      <p class="m-0">{m.pickConversation}</p>
    </div>

    <div class="msg-suggest" data-chat-suggest>
      {m.chat.map((entry) => (
        <button type="button" data-ask={entry.q}>{entry.q}</button>
      ))}
      <button type="button" data-ask-mail>{SITE.email}</button>
    </div>

    <form class="msg-compose" data-chat-form novalidate>
      <input
        type="text"
        data-chat-input
        placeholder={m.input}
        aria-label={m.input}
        autocomplete="off"
        maxlength="600"
      />
      <button class="msg-send" type="submit" aria-label={m.send}>
        <Icon id="ui-arrow" size={15} />
      </button>
    </form>

    {/* O que o dono vê em vez da barra de escrever. */}
    <div class="msg-owner-bar" data-msg-owner-bar hidden>
      <p data-msg-owner-note>{m.ownerReading}</p>
    </div>

    <p class="msg-note" data-chat-note>{m.aiOff}</p>

    {/* As respostas guardadas, para quando não há modelo configurado.
        Fora do registo, para o "Recomeçar" não ter de as varrer. */}
    <div hidden data-chat-canned>
      {m.chat.map((entry) => (
        <div class="chat-canned" data-q={entry.q}><span>{entry.a}</span></div>
      ))}
    </div>
  </div>
</section>
