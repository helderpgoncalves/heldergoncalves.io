---
import { SITE, COPY, type Lang } from '../../../siteConfig';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = COPY[lang];
const m = c.mensagens;
---
<section class="app-shell app-mensagens" data-content="mensagens" aria-label={c.apps.mensagens.name}>
  <div class="chat">
    <div class="chat-head">
      <span class="avatar" aria-hidden="true">H</span>
      <div>
        <strong>{m.contactName}</strong>
        <span>{m.status}</span>
      </div>
      <button class="btn" type="button" data-chat-reset style="margin-left:auto">{m.restart}</button>
    </div>

    <div class="chat-log" data-chat-log aria-live="polite">
      <p class="chat-time">{c.os.today}</p>
      <p class="bubble them">{m.opener}</p>
      {m.chat.map((entry) => (
        <div class="chat-canned" hidden data-q={entry.q}>
          <p class="bubble me">{entry.q}</p>
          <p class="bubble them">{entry.a}</p>
        </div>
      ))}
    </div>

    <div class="chat-suggest" data-chat-suggest>
      {m.chat.map((entry) => (
        <button type="button" data-ask={entry.q}>{entry.q}</button>
      ))}
      <button type="button" data-ask-mail>{SITE.email}</button>
    </div>
  </div>
</section>
