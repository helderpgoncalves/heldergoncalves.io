---
// A casca do sistema. Tudo o que aqui está é HTML normal: o
// JavaScript só o transforma em janelas e gestos. Sem JavaScript,
// o leitor recebe o documento simples que está dentro de #pool.
import { SITE, COPY, ROUTES, APPS, other, formatDate, readingMinutes, type Lang, type AppId } from '../../siteConfig';
import { postPath, postSlug, type Post } from '../../lib/posts';
import IconSprite from './IconSprite.astro';
import Icon from './Icon.astro';
import Sobre from './apps/Sobre.astro';
import Escritos from './apps/Escritos.astro';
import Mensagens from './apps/Mensagens.astro';
import Contacto from './apps/Contacto.astro';
import Projetos from './apps/Projetos.astro';
import Terminal from './apps/Terminal.astro';
import Definicoes from './apps/Definicoes.astro';
import Simulador from './apps/Simulador.astro';

interface Props {
  lang: Lang;
  posts: Post[];
  /** Escrito aberto quando a página é um /blog/<slug>/. */
  post?: Post;
  altPath?: string;
  /** Aplicação aberta no arranque, nos dois modos. */
  boot?: AppId;
  /** Aplicação aberta no arranque só no Mac (no telefone fica o ecrã inicial). */
  bootMac?: AppId;
  /** Título e texto do documento simples (sem JavaScript). */
  docTitle: string;
  docLead: string;
}

const { lang, posts, post, altPath, boot, bootMac, docTitle, docLead } = Astro.props;
const c = COPY[lang];
const alt = other(lang);
const dockApps = APPS.filter((a) => a.dock);
const iosDock = APPS.filter((a) => a.iosDock);
const iosGrid = APPS.filter((a) => !a.iosDock);
const latest = posts[0];

// A saudação escrita à mão, um traço contínuo por língua. Coordenadas
// nossas: desenhadas curva a curva, não decalcadas de lado nenhum.
const GREETING_PT =
  'M 20 70 C 18 50 32 38 48 40 C 62 42 64 60 52 72 C 40 84 22 80 20 62 ' +
  'C 18 46 36 38 54 42 C 62 44 66 56 68 68 C 74 50 86 26 98 14 ' +
  'C 104 8 92 4 84 12 C 76 22 74 42 82 58 C 87 70 98 74 106 64 ' +
  'M 146 42 C 134 34 118 42 118 58 C 118 74 132 80 142 70 C 150 62 152 50 150 40 ' +
  'C 149 52 146 66 148 72 C 150 80 158 80 166 70 ' +
  'M 130 22 L 146 12';
const GREETING_EN =
  'M 18 70 C 24 52 36 26 48 14 C 54 8 42 4 34 12 C 26 22 24 44 32 60 ' +
  'C 36 68 42 70 46 62 C 52 48 62 34 72 34 C 80 34 80 46 76 56 ' +
  'C 73 64 76 70 84 68 C 92 66 98 58 100 50 C 102 42 96 36 88 40 ' +
  'C 78 45 74 60 82 66 C 90 72 102 68 108 58 C 116 42 128 22 138 12 ' +
  'C 144 6 134 2 126 10 C 118 20 116 42 124 58 C 128 66 134 68 138 60 ' +
  'C 146 42 158 22 168 12 C 174 6 164 2 156 10 C 148 20 146 42 154 58 ' +
  'C 158 66 164 68 168 60 C 176 44 190 34 202 38 C 212 41 214 56 204 64 ' +
  'C 194 72 180 66 180 54 C 180 42 194 34 208 38 C 216 40 220 50 222 60';

// Tudo o que o JavaScript precisa de saber, já traduzido.
const osData = {
  lang,
  alt,
  intlLocale: c.intlLocale,
  routes: ROUTES,
  altHome: ROUTES[alt].home,
  site: { email: SITE.email, github: SITE.github, linkedin: SITE.linkedin, twitter: SITE.twitter, name: SITE.name },
  boot: boot ?? null,
  bootMac: bootMac ?? null,
  bootPost: post ? postSlug(post) : null,
  apps: APPS.map((a) => ({
    id: a.id,
    name: c.apps[a.id].name,
    subtitle: c.apps[a.id].subtitle,
    window: c.apps[a.id].window,
    win: a.win,
    bare: Boolean(a.bare),
  })),
  menus: c.os.menus,
  menuLabels: c.os.menuLabels,
  strings: {
    ...c.os,
    close: c.os.close,
    terminal: c.terminal,
    contact: { ...c.contacto },
    // As perguntas guardadas já estão no HTML — não se repetem aqui.
    chat: { ...c.mensagens, chat: undefined },
    escritos: { pick: c.escritos.pick, backToList: c.escritos.backToList, readingTime: c.escritos.readingTime },
  },
  posts: posts.map((p) => ({
    slug: postSlug(p),
    title: p.data.title,
    description: p.data.description,
    url: postPath(p, lang),
    date: formatDate(p.data.date, lang),
    minutes: readingMinutes(p.body),
  })),
};
---
<IconSprite />

<div class="os" id="os">
  <!-- Arranque: o monograma desenha-se a si próprio, como um
       dispositivo a acordar. Traços com pathLength=1, por isso a
       animação é exata em qualquer tamanho. -->
  {/* O arranque escreve-se, letra a letra. `pathLength="1"` normaliza o
      comprimento do traço, por isso o desenho é uma só animação de
      `stroke-dashoffset` de 1 a 0 — e a ordem dos subcaminhos é a ordem
      por que a mão escreveria. Os caminhos são desenhados aqui; não vêm
      de lado nenhum. */}
  <div class="boot" id="boot" hidden>
    <svg
      class="boot-hand"
      viewBox={lang === 'pt' ? '10 0 164 86' : '10 0 222 82'}
      role="img"
      aria-label={c.os.greeting}
    >
      <path
        class="ink"
        pathLength="1"
        fill="none"
        stroke="currentColor"
        stroke-width="6.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        d={lang === 'pt' ? GREETING_PT : GREETING_EN}
      />
    </svg>
    <p class="boot-name">{SITE.name}</p>
    <div class="boot-bar"><span></span></div>
    <p class="boot-label">{c.os.booting} {c.os.macName}…</p>
  </div>

  <!-- ── macOS ─────────────────────────────────────────────── -->
  <div class="mac" id="mac">
    <div class="wall" aria-hidden="true"></div>

    <div class="menubar glass" id="menubar" role="menubar" aria-label={c.os.macName}>
      <button class="menubar-item" data-menu="apple" aria-haspopup="true" aria-expanded="false" aria-label={c.os.macName}>
        <Icon id="ui-apple" size={14} />
      </button>
      <button class="menubar-item strong" data-menu="app" id="menuApp" aria-haspopup="true" aria-expanded="false">Finder</button>
      <button class="menubar-item" data-menu="window" aria-haspopup="true" aria-expanded="false">{c.os.menuLabels.window}</button>
      <button class="menubar-item" data-menu="help" aria-haspopup="true" aria-expanded="false">{c.os.menuLabels.help}</button>
      <span class="menubar-spacer"></span>
      <span class="menubar-right">
        <button class="menubar-item" data-action="spotlight" aria-label={c.os.search}><Icon id="ui-search" size={13} /></button>
        <button class="menubar-item" data-action="open:definicoes" aria-label={c.os.control.title}><Icon id="ui-control" size={14} /></button>
        <span class="menubar-item" aria-hidden="true"><Icon id="ui-wifi" size={13} /></span>
        <span class="menubar-item" aria-hidden="true"><Icon id="ui-battery" size={16} /></span>
        <span class="menu-clock" data-clock-mac></span>
      </span>
    </div>

    <div class="desktop" id="desktop">
      <div class="desk-icons">
        <button class="desk-icon" type="button" data-open="sobre">
          <Icon id="icon-disk" size={46} />{c.os.desktopHd}
        </button>
        <button class="desk-icon" type="button" data-open="projetos">
          <Icon id="icon-doc" size={46} />{c.os.desktopCv}
        </button>
      </div>
      <div class="windows" id="windows"></div>
      <p class="hint">{c.os.hintMac}</p>
    </div>

    <div class="dock-wrap">
      <div class="dock glass" id="dock" role="toolbar" aria-label="Dock">
        {dockApps.map((a) => (
          <button class="dock-item" type="button" data-open={a.id} aria-label={c.apps[a.id].name}>
            <Icon id={a.id} />
            <span class="dot" aria-hidden="true"></span>
            <span class="dock-tip" aria-hidden="true">{c.apps[a.id].name}</span>
          </button>
        ))}
        <span class="dock-sep" aria-hidden="true"></span>
        <button class="dock-item" type="button" data-trash aria-label={c.os.trash}>
          <Icon id="icon-trash" />
          <span class="dock-tip" aria-hidden="true">{c.os.trash}</span>
        </button>
      </div>
    </div>

    <div class="spotlight" id="spotlight" hidden>
      <div class="spot-box glass" role="dialog" aria-label={c.os.search}>
        <div class="spot-input">
          <Icon id="ui-search" size={18} />
          <input type="text" id="spotInput" placeholder={c.os.search} autocomplete="off" spellcheck="false" />
        </div>
        <div class="spot-results" id="spotResults" role="listbox"></div>
        <p class="spot-foot">{c.os.searchHint}</p>
      </div>
    </div>
  </div>

  <!-- ── iOS ───────────────────────────────────────────────── -->
  <div class="ios" id="ios">
    <div class="phone" id="phone">
      <div class="wall ios-wall" aria-hidden="true"></div>

      <div class="statusbar">
        <span class="clock" data-clock-ios></span>
        <span class="status-right" aria-hidden="true">
          <Icon id="ui-cell" size={17} />
          <Icon id="ui-wifi" size={15} />
          <Icon id="ui-battery" size={24} />
        </span>
      </div>
      <div class="island" id="island" aria-hidden="true"><span class="island-text"></span></div>

      <div class="sb" id="springboard">
        <div class="sb-pages" id="sbPages">
          <div class="sb-page">
            <div class="sb-widgets">
              <div class="widget glass glass-clear widget-date">
                <p class="w-day" data-widget-day></p>
                <p class="w-date" data-widget-date></p>
              </div>
              {latest && (
                <button class="widget glass glass-clear widget-post" type="button" data-open-post={postSlug(latest)}>
                  <span class="w-kicker">{c.escritos.heading}</span>
                  <span class="w-title">{latest.data.title}</span>
                  <span class="w-meta">{formatDate(latest.data.date, lang)}</span>
                </button>
              )}
            </div>
            <div class="sb-grid">
              {iosGrid.map((a) => (
                <button class="sb-app" type="button" data-open={a.id}>
                  <Icon id={a.id} />
                  <span class="label">{c.apps[a.id].name}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="sb-page">
            <div class="sb-widgets one">
              <div class="widget glass glass-clear widget-list">
                <span class="w-kicker">{c.escritos.heading}</span>
                {posts.slice(0, 3).map((p) => (
                  <button class="w-row" type="button" data-open-post={postSlug(p)}>
                    <span class="w-row-title">{p.data.title}</span>
                    <span class="w-row-meta">{formatDate(p.data.date, lang)}</span>
                  </button>
                ))}
                {posts.length === 0 && <span class="w-meta">{c.escritos.empty}</span>}
              </div>
              <div class="widget glass glass-clear widget-links">
                <span class="w-kicker">{c.contacto.elsewhere}</span>
                <div class="w-links">
                  <a href={`mailto:${SITE.email}`} aria-label={c.labels.email}><Icon id="ui-mail" size={20} /></a>
                  <a href={SITE.github} target="_blank" rel="noopener me" aria-label={c.labels.github}><Icon id="ui-github" size={20} /></a>
                  <a href={SITE.linkedin} target="_blank" rel="noopener me" aria-label={c.labels.linkedin}><Icon id="ui-linkedin" size={20} /></a>
                  <a href={SITE.twitter} target="_blank" rel="noopener me" aria-label={c.labels.twitter}><Icon id="ui-twitter" size={20} /></a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="sb-dots" id="sbDots" aria-hidden="true"><i class="on"></i><i></i></div>

        <div class="ios-dock glass glass-clear">
          {iosDock.map((a) => (
            <button class="sb-app" type="button" data-open={a.id}>
              <Icon id={a.id} />
              <span class="label">{c.apps[a.id].name}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="ios-views" id="iosViews"></div>
      <div class="switcher" id="switcher" aria-label={c.os.appSwitcher}><div class="switcher-rail"></div></div>

      <div class="cc glass glass-dark" id="cc" role="dialog" aria-label={c.os.control.title}>
        <div class="cc-grid">
          <button class="cc-tile span2" type="button" data-cc="theme">
            <Icon id="ui-moon" size={20} />
            <span class="t-label">{c.os.control.theme}</span>
            <span class="t-value" data-cc-theme>{c.os.control.light}</span>
          </button>
          <div class="cc-slider" data-cc="brightness" role="slider" aria-label={c.os.control.brightness} aria-valuemin="30" aria-valuemax="100" aria-valuenow="100" tabindex="0" style="grid-row:span 2">
            <span class="fill"></span>
            <Icon id="ui-sun" class="ico" size={20} />
          </div>
          <button class="cc-tile" type="button" data-cc="lang">
            <Icon id="ui-globe" size={20} />
            <span class="t-value">{lang === 'pt' ? 'EN' : 'PT'}</span>
          </button>
          <button class="cc-tile span2" type="button" data-cc="wallpaper">
            <span class="t-label">{c.os.control.wallpaper}</span>
            <span class="t-value" data-cc-wall></span>
          </button>
          <button class="cc-tile span2" type="button" data-cc="settings">
            <span class="t-label">{c.apps.definicoes.name}</span>
            <span class="t-value">{c.apps.definicoes.subtitle}</span>
          </button>
        </div>
        <button class="cc-close" type="button" data-cc="close">{c.os.done}</button>
      </div>

      <div class="nc glass glass-dark" id="nc" role="dialog" aria-label={c.os.notifications}>
        <div class="nc-inner">
          <p class="nc-title">{c.os.notifications}</p>
          {posts.slice(0, 3).map((p) => (
            <button class="nc-note" type="button" data-open-post={postSlug(p)}>
              <span class="nc-app"><Icon id="escritos" size={17} />{c.escritos.heading}</span>
              <strong>{p.data.title}</strong>
              <span>{p.data.description}</span>
              <span class="nc-when">{formatDate(p.data.date, lang)}</span>
            </button>
          ))}
          <button class="nc-note" type="button" data-open="contacto">
            <span class="nc-app"><Icon id="contacto" size={17} />{c.apps.contacto.name}</span>
            <strong>{c.contacto.lead}</strong>
            <span>{SITE.email}</span>
          </button>
        </div>
        <button class="cc-close" type="button" data-nc-close>{c.os.done}</button>
      </div>

      <!-- Ecrã bloqueado. Tem fundo próprio: sem ele via-se o ecrã
           inicial por trás e não se percebia o que era para fazer. -->
      <div class="lock" id="lock" hidden>
        <div class="wall" aria-hidden="true"></div>
        <div class="lock-scrim" aria-hidden="true"></div>

        <div class="lock-body">
          <div class="lock-top">
            <span class="lock-padlock" aria-hidden="true"><Icon id="ui-lock" size={15} /></span>
            <p class="lock-date" data-lock-date></p>
            <p class="lock-time" data-lock-time></p>
          </div>

          <div class="lock-notes">
            {posts.slice(0, 2).map((p) => (
              <button class="lock-note glass glass-clear" type="button" data-open-post={postSlug(p)}>
                <span class="ln-icon"><Icon id="escritos" size={30} /></span>
                <span class="ln-text">
                  <strong>{p.data.title}</strong>
                  <span>{p.data.description}</span>
                </span>
                <span class="ln-when">{formatDate(p.data.date, lang)}</span>
              </button>
            ))}
          </div>

          <div class="lock-bottom">
            <div class="lock-actions glass glass-clear">
              <button class="lock-action" type="button" data-open="escritos" aria-label={c.apps.escritos.name}>
                <Icon id="ui-note" size={22} />
              </button>
              <button class="lock-action" type="button" data-open="contacto" aria-label={c.apps.contacto.name}>
                <Icon id="ui-mail" size={22} />
              </button>
            </div>

            <button class="lock-open" type="button" data-unlock>
              <span class="lock-arrow" aria-hidden="true">
                <Icon id="ui-chevron" size={16} />
              </span>
              <span class="lock-open-label">{c.os.unlock}</span>
            </button>

            <div class="lock-indicator" aria-hidden="true"><i></i></div>
          </div>
        </div>
      </div>

      <div class="homebar" id="homebar"><i></i></div>
    </div>
  </div>

  <div class="dim" aria-hidden="true"></div>
</div>

<!-- ── O documento por baixo do sistema ─────────────────────── -->
<div class="doc" id="pool">
  <div class="doc-head">
    {/* Nos escritos o título principal é o do texto, mais abaixo. Um por página. */}
    {post ? <p class="doc-kicker">{docTitle}</p> : <h1>{docTitle}</h1>}
    <p>{docLead}</p>
    <p><a href={ROUTES[alt].home}>{c.switch}</a> · <a href={ROUTES[lang].feed}>{c.labels.rss}</a></p>
  </div>
  <Sobre lang={lang} />
  <Escritos lang={lang} posts={posts} post={post} altPath={altPath} />
  <Mensagens lang={lang} />
  <Contacto lang={lang} />
  <Projetos lang={lang} />
  <Terminal lang={lang} />
  <Definicoes lang={lang} />
  <Simulador lang={lang} />
</div>

<script type="application/json" id="os-data" is:inline set:html={JSON.stringify(osData).replace(/</g, "\\u003c")}></script>
