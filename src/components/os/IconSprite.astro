---
// Todos os ícones num sprite só, numa caixa de 100×100.
//
// Os ícones das aplicações da Apple são os verdadeiros, extraídos dos
// `.icns` do próprio macOS do Hélder (`iconutil -c iconset`) — ver
// NOTICE.md. O maior tamanho que estes `.icns` trazem no Tahoe é
// 256×256; como é exactamente o `ICON_PX` a que o build já reduzia
// tudo (o maior que um ícone chega a ter no ecrã, com a Dock ampliada
// num ecrã a 2×), não se perde nada. É o `astro:assets` a converter
// para WebP uma vez no build, para que em produção não se calcule nada.
//
// Um ícone do macOS traz a sua margem: o quadrado ocupa 824 dos 1024 px
// da imagem, com 100 de folga a toda a volta para a sombra. Para ficar
// do tamanho dos nossos, a imagem é desenhada a 124,27 e puxada 12,14
// para fora; o que sobra é margem e fica de fora da caixa.
//
// Os outros são desenhados aqui. Os glifos são do Lucide (lucide.dev,
// ISC) e as marcas do Simple Icons (CC0) — ver NOTICE.md. O que segue
// as regras da Apple é a *geometria*, que é matemática e não obra
// protegida.
//
// A forma: o canto contínuo, com raio de 22,37% do lado — a medida da
// máscara dos ícones do iOS. Um canto contínuo não é um arco de
// círculo: o arco só cobre 36° no meio do canto, e de cada lado dele
// entram duas curvas de Bézier que o entregam ao lado a direito sem
// salto de curvatura. Por isso o canto ocupa 35,79 do lado (1,6× o
// raio) e o lado a direito só existe entre 35,79 e 64,21. É esta
// transição suave — e não o raio — que distingue a forma da Apple de
// um `border-radius` qualquer.
//
// O resto: margem de ~10%, o motivo principal a ocupar cerca de dois
// terços do lado, e o traço na ordem dos 6%. As cores são os valores
// das cores de sistema do iOS, com o gradiente que a Apple usa:
// aclarar em cima, escurecer ligeiramente em baixo.
import { getImage } from 'astro:assets';
import finder from '../../assets/icons/finder.png';
import notes from '../../assets/icons/notes.png';
import mail from '../../assets/icons/mail.png';
import safari from '../../assets/icons/safari.png';
import terminal from '../../assets/icons/terminal.png';
import settings from '../../assets/icons/settings.png';
import stocks from '../../assets/icons/stocks.png';
import messages from '../../assets/icons/messages.png';
import calendario from '../../assets/icons/calendar.png';
import contacts from '../../assets/icons/contacts.png';
import simulator from '../../assets/icons/simulator.png';
import safari26 from '../../assets/icons/safari26.png';
import iosNotes from '../../assets/icons/ios/notes.png';
import iosMail from '../../assets/icons/ios/mail.svg';
import iosContacts from '../../assets/icons/ios/contacts.svg';

const ICON_PX = 256;
const shrink = (src: ImageMetadata) => getImage({ src, width: ICON_PX, height: ICON_PX, format: 'webp' });

/** Que ícone verdadeiro serve cada aplicação. */
const real: Record<string, string> = {
  sobre: (await shrink(finder)).src,
  escritos: (await shrink(notes)).src,
  contacto: (await shrink(mail)).src,
  projetos: (await shrink(safari)).src,
  terminal: (await shrink(terminal)).src,
  definicoes: (await shrink(settings)).src,
  bolsa: (await shrink(stocks)).src,
  mensagens: (await shrink(messages)).src,
  calendario: (await shrink(calendario)).src,
  pessoas: (await shrink(contacts)).src,
  simulador: (await shrink(simulator)).src,
};

/** A imagem no lugar do quadrado: 1024/824 do lado, 100/824 para fora. */
const FIT = { size: (100 * 1024) / 824, offset: (-100 * 100) / 824 };

/**
 * No telefone os ícones são os do iOS: sem margem, sem sombra, a
 * encher o quadrado. Onde o iOS tem um ícone próprio (Contactos, Notas,
 * Mail, Safari) é esse; onde a imagem é a mesma nos dois sistemas
 * (Mensagens, Calendário, Bolsa) o desenho serve os dois. Os SVG vão
 * tal como estão — o Astro não os toca — e o PNG das Notas já tem o
 * tamanho de um ícone do iPhone a 3×.
 */
const ios: Record<string, string> = {
  sobre: iosContacts.src,
  escritos: iosNotes.src,
  contacto: iosMail.src,
  projetos: (await shrink(safari26)).src,
};
/** O Safari 26 traz 3 % de margem à volta do quadrado. */
const FIT26 = { size: (100 * 300) / 282, offset: (-9 * 100) / 282 };
---
<svg class="sprite" aria-hidden="true" focusable="false" width="0" height="0">
  <defs>
    <linearGradient id="g-mensagens" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5bf675"/><stop offset="1" stop-color="#0cbd2a"/></linearGradient>
    <linearGradient id="g-definicoes" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#A7A7AB"/><stop offset="1" stop-color="#85858A"/></linearGradient>
    <linearGradient id="g-disk" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#D3D3D7"/><stop offset="1" stop-color="#BBBBC0"/></linearGradient>
    <linearGradient id="g-doc" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3897FF"/><stop offset="1" stop-color="#0073F0"/></linearGradient>
    <linearGradient id="g-simulador" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3A4A63"/><stop offset="1" stop-color="#101827"/></linearGradient>
    <radialGradient id="g-spot" cx=".32" cy=".14" r=".9">
      <stop offset="0" stop-color="#fff" stop-opacity=".20"/>
      <stop offset="1" stop-color="#fff" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="g-shade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#000" stop-opacity="0"/>
      <stop offset=".6" stop-color="#000" stop-opacity="0"/>
      <stop offset="1" stop-color="#000" stop-opacity=".13"/>
    </linearGradient>
    <clipPath id="sq"><path d="M 35.792 0 L 64.208 0 c 12.528 0 18.793 0 23.578 2.438 a 22.37 22.37 0 0 1 9.776 9.776 c 2.438 4.785 2.438 11.049 2.438 23.578 L 100 64.208 c 0 12.528 0 18.793 -2.438 23.578 a 22.37 22.37 0 0 1 -9.776 9.776 c -4.785 2.438 -11.049 2.438 -23.578 2.438 L 35.792 100 c -12.528 0 -18.793 0 -23.578 -2.438 a 22.37 22.37 0 0 1 -9.776 -9.776 c -2.438 -4.785 -2.438 -11.049 -2.438 -23.578 L 0 35.792 c 0 -12.528 0 -18.793 2.438 -23.578 a 22.37 22.37 0 0 1 9.776 -9.776 c 4.785 -2.438 11.049 -2.438 23.578 -2.438 Z"/></clipPath>
  </defs>

  <!-- ── O mapa de refração ──────────────────────────────────────
       O vermelho diz quanto cada ponto do fundo se desloca na
       horizontal, o verde na vertical; 128 é ficar quieto. Junto às
       bordas os valores afastam-se de 128, e é aí que o fundo se
       entorta — como acontece na borda de uma lente. O centro fica
       intacto, para o conteúdo continuar legível.
       Só o Chromium aplica filtros SVG a `backdrop-filter`; nos
       outros esta camada não pinta nada e o vidro por baixo mantém-se.
       ────────────────────────────────────────────────────────── -->
  <filter id="lg-refract" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
    <feImage href="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='240' height='240'%3E%3Cdefs%3E%3ClinearGradient id='x' x1='0' y1='0' x2='1' y2='0'%3E%3Cstop offset='0' stop-color='rgb(0,0,0)'/%3E%3Cstop offset='0.13' stop-color='rgb(128,0,0)'/%3E%3Cstop offset='0.87' stop-color='rgb(128,0,0)'/%3E%3Cstop offset='1' stop-color='rgb(255,0,0)'/%3E%3C/linearGradient%3E%3ClinearGradient id='y' x1='0' y1='0' x2='0' y2='1'%3E%3Cstop offset='0' stop-color='rgb(0,0,0)'/%3E%3Cstop offset='0.13' stop-color='rgb(0,128,0)'/%3E%3Cstop offset='0.87' stop-color='rgb(0,128,0)'/%3E%3Cstop offset='1' stop-color='rgb(0,255,0)'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='240' height='240' fill='url(%23x)'/%3E%3Crect width='240' height='240' fill='url(%23y)' style='mix-blend-mode:screen'/%3E%3C/svg%3E" preserveAspectRatio="none" x="0%" y="0%" width="100%" height="100%" result="mapa" />
    <feDisplacementMap in="SourceGraphic" in2="mapa" scale="10" xChannelSelector="R" yChannelSelector="G" />
  </filter>

  <symbol id="icon-sobre" viewBox="0 0 100 100">
    <g class="ic-mac"><image href={real.sobre} x={FIT.offset} y={FIT.offset} width={FIT.size} height={FIT.size} /></g>
    <g class="ic-ios" clip-path="url(#sq)"><image href={ios.sobre} width="100" height="100" /></g>
  </symbol>
  <symbol id="icon-contacto" viewBox="0 0 100 100">
    <g class="ic-mac"><image href={real.contacto} x={FIT.offset} y={FIT.offset} width={FIT.size} height={FIT.size} /></g>
    <g class="ic-ios" clip-path="url(#sq)"><image href={ios.contacto} width="100" height="100" /></g>
  </symbol>
  <symbol id="icon-projetos" viewBox="0 0 100 100">
    <g class="ic-mac"><image href={real.projetos} x={FIT.offset} y={FIT.offset} width={FIT.size} height={FIT.size} /></g>
    <g class="ic-ios" clip-path="url(#sq)"><image href={ios.projetos} x={FIT26.offset} y={FIT26.offset} width={FIT26.size} height={FIT26.size} /></g>
  </symbol>
  <symbol id="icon-definicoes" viewBox="0 0 100 100">
    <g class="ic-mac"><image href={real.definicoes} x={FIT.offset} y={FIT.offset} width={FIT.size} height={FIT.size} /></g>
    <g class="ic-ios" clip-path="url(#sq)"><image href={real.definicoes} x={FIT.offset} y={FIT.offset} width={FIT.size} height={FIT.size} /></g>
  </symbol>
  <symbol id="icon-disk" viewBox="0 0 100 100">
    <g clip-path="url(#sq)">
      <rect width="100" height="100" fill="url(#g-disk)"/>
      <g transform="translate(20.00 20.00) scale(2.5000)" fill="none" stroke="#5A5A63" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><line x1="22" x2="2" y1="12" y2="12" /> <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" /> <line x1="6" x2="6.01" y1="16" y2="16" /> <line x1="10" x2="10.01" y1="16" y2="16" /></g>
      <rect width="100" height="100" fill="url(#g-spot)"/>
      <rect width="100" height="100" fill="url(#g-shade)"/>
    </g>
    <path d="M 35.792 0 L 64.208 0 c 12.528 0 18.793 0 23.578 2.438 a 22.37 22.37 0 0 1 9.776 9.776 c 2.438 4.785 2.438 11.049 2.438 23.578 L 100 64.208 c 0 12.528 0 18.793 -2.438 23.578 a 22.37 22.37 0 0 1 -9.776 9.776 c -4.785 2.438 -11.049 2.438 -23.578 2.438 L 35.792 100 c -12.528 0 -18.793 0 -23.578 -2.438 a 22.37 22.37 0 0 1 -9.776 -9.776 c -2.438 -4.785 -2.438 -11.049 -2.438 -23.578 L 0 35.792 c 0 -12.528 0 -18.793 2.438 -23.578 a 22.37 22.37 0 0 1 9.776 -9.776 c 4.785 -2.438 11.049 -2.438 23.578 -2.438 Z" fill="none" stroke="#000" stroke-opacity=".09" stroke-width="1"/>
  </symbol>
  <symbol id="icon-doc" viewBox="0 0 100 100">
    <g clip-path="url(#sq)">
      <rect width="100" height="100" fill="url(#g-doc)"/>
      <g transform="translate(21.00 21.00) scale(2.4167)" fill="none" stroke="#fff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /> <path d="M14 2v4a2 2 0 0 0 2 2h4" /> <path d="M10 9H8" /> <path d="M16 13H8" /> <path d="M16 17H8" /></g>
      <rect width="100" height="100" fill="url(#g-spot)"/>
      <rect width="100" height="100" fill="url(#g-shade)"/>
    </g>
    <path d="M 35.792 0 L 64.208 0 c 12.528 0 18.793 0 23.578 2.438 a 22.37 22.37 0 0 1 9.776 9.776 c 2.438 4.785 2.438 11.049 2.438 23.578 L 100 64.208 c 0 12.528 0 18.793 -2.438 23.578 a 22.37 22.37 0 0 1 -9.776 9.776 c -4.785 2.438 -11.049 2.438 -23.578 2.438 L 35.792 100 c -12.528 0 -18.793 0 -23.578 -2.438 a 22.37 22.37 0 0 1 -9.776 -9.776 c -2.438 -4.785 -2.438 -11.049 -2.438 -23.578 L 0 35.792 c 0 -12.528 0 -18.793 2.438 -23.578 a 22.37 22.37 0 0 1 9.776 -9.776 c 4.785 -2.438 11.049 -2.438 23.578 -2.438 Z" fill="none" stroke="#000" stroke-opacity=".09" stroke-width="1"/>
  </symbol>
  <symbol id="icon-escritos" viewBox="0 0 100 100">
    <g class="ic-mac"><image href={real.escritos} x={FIT.offset} y={FIT.offset} width={FIT.size} height={FIT.size} /></g>
    <g class="ic-ios" clip-path="url(#sq)"><image href={ios.escritos} width="100" height="100" /></g>
  </symbol>
  <symbol id="icon-mensagens" viewBox="0 0 100 100"><image href={real.mensagens} x={FIT.offset} y={FIT.offset} width={FIT.size} height={FIT.size} /></symbol>
  <symbol id="icon-terminal" viewBox="0 0 100 100"><image href={real.terminal} x={FIT.offset} y={FIT.offset} width={FIT.size} height={FIT.size} /></symbol>
  <symbol id="icon-simulador" viewBox="0 0 100 100"><image href={real.simulador} x={FIT.offset} y={FIT.offset} width={FIT.size} height={FIT.size} /></symbol>
  <symbol id="icon-bolsa" viewBox="0 0 100 100"><image href={real.bolsa} x={FIT.offset} y={FIT.offset} width={FIT.size} height={FIT.size} /></symbol>
  <!-- O número do dia não vem do .icns — a Apple desenha-o em tempo real
       por cima do molde vazio, no lugar da grelha de pontos. Fazemos o
       mesmo: o retângulo branco tapa os pontos, e `state.js` põe aqui a
       data de hoje ao arrancar (e a cada tick do relógio). -->
  <symbol id="icon-calendario" viewBox="0 0 100 100">
    <image href={real.calendario} x={FIT.offset} y={FIT.offset} width={FIT.size} height={FIT.size} />
    <path d="M 8 30 L 92 30 L 92 78 c 0 8.5 -6.5 14 -14 14 L 22 92 c -7.5 0 -14 -5.5 -14 -14 Z" fill="#fff"/>
    <text id="ic-calendario-dia" x="50" y="76" text-anchor="middle" font-family="-apple-system, system-ui, sans-serif" font-weight="600" font-size="46" fill="#000">1</text>
  </symbol>
  <symbol id="icon-pessoas" viewBox="0 0 100 100">
    <g class="ic-mac"><image href={real.pessoas} x={FIT.offset} y={FIT.offset} width={FIT.size} height={FIT.size} /></g>
    <g class="ic-ios" clip-path="url(#sq)"><image href={ios.sobre} width="100" height="100" /></g>
  </symbol>
  <symbol id="icon-trash" viewBox="0 0 100 100">
    <g clip-path="url(#sq)">
      <rect width="100" height="100" fill="#fff" fill-opacity=".17"/>
      <g transform="translate(21.00 21.00) scale(2.4167)" fill="none" stroke="#fff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18" /> <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" /> <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" /> <line x1="10" x2="10" y1="11" y2="17" /> <line x1="14" x2="14" y1="11" y2="17" /></g>
      <rect width="100" height="100" fill="url(#g-spot)"/>
    </g>
    <path d="M 35.792 0 L 64.208 0 c 12.528 0 18.793 0 23.578 2.438 a 22.37 22.37 0 0 1 9.776 9.776 c 2.438 4.785 2.438 11.049 2.438 23.578 L 100 64.208 c 0 12.528 0 18.793 -2.438 23.578 a 22.37 22.37 0 0 1 -9.776 9.776 c -4.785 2.438 -11.049 2.438 -23.578 2.438 L 35.792 100 c -12.528 0 -18.793 0 -23.578 -2.438 a 22.37 22.37 0 0 1 -9.776 -9.776 c -2.438 -4.785 -2.438 -11.049 -2.438 -23.578 L 0 35.792 c 0 -12.528 0 -18.793 2.438 -23.578 a 22.37 22.37 0 0 1 9.776 -9.776 c 4.785 -2.438 11.049 -2.438 23.578 -2.438 Z" fill="none" stroke="#fff" stroke-opacity=".26" stroke-width="1.5"/>
  </symbol>

  <!-- Interface -->
  <symbol id="ui-search" viewBox="0 0 100 100"><g transform="translate(9.00 9.00) scale(3.4167)" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /> <path d="m21 21-4.3-4.3" /></g></symbol>
  <symbol id="ui-control" viewBox="0 0 100 100"><g transform="translate(8.00 8.00) scale(3.5000)" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><line x1="21" x2="14" y1="4" y2="4" /> <line x1="10" x2="3" y1="4" y2="4" /> <line x1="21" x2="12" y1="12" y2="12" /> <line x1="8" x2="3" y1="12" y2="12" /> <line x1="21" x2="16" y1="20" y2="20" /> <line x1="12" x2="3" y1="20" y2="20" /> <line x1="14" x2="14" y1="2" y2="6" /> <line x1="8" x2="8" y1="10" y2="14" /> <line x1="16" x2="16" y1="18" y2="22" /></g></symbol>
  <symbol id="ui-wifi" viewBox="0 0 100 100"><g transform="translate(7.00 7.00) scale(3.5833)" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h.01" /> <path d="M2 8.82a15 15 0 0 1 20 0" /> <path d="M5 12.859a10 10 0 0 1 14 0" /> <path d="M8.5 16.429a5 5 0 0 1 7 0" /></g></symbol>
  <symbol id="ui-chevron" viewBox="0 0 100 100"><g transform="translate(7.00 7.00) scale(3.5833)" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></g></symbol>
  <symbol id="ui-arrow" viewBox="0 0 100 100"><g transform="translate(8.00 8.00) scale(3.5000)" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /> <path d="m12 5 7 7-7 7" /></g></symbol>
  <symbol id="ui-note" viewBox="0 0 100 100"><g transform="translate(8.00 8.00) scale(3.5000)" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M13.4 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7.4" /> <path d="M2 6h4" /> <path d="M2 10h4" /> <path d="M2 14h4" /> <path d="M2 18h4" /> <path d="M21.378 5.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z" /></g></symbol>
