---
// Todos os ícones num sprite só, numa caixa de 100×100.
//
// Os ícones do Finder, das Notas, do Mail, do Safari e do Terminal são
// os verdadeiros, os da Apple, tal como vêm com o componente
// mac-os-dock de 21st.dev — ver NOTICE.md. Chegam com 1024 px e são
// reduzidos no build a 256 px em WebP (o maior que um ícone chega a
// ter no ecrã, com a Dock ampliada num ecrã a 2×), para que em produção
// não se calcule nada: é o `astro:assets` a fazê-lo uma vez.
//
// Um ícone do macOS traz a sua margem: o quadrado ocupa 824 dos 1024 px
// da imagem, com 100 de folga a toda a volta para a sombra. Para ficar
// do tamanho dos nossos, a imagem é desenhada a 124,27 e puxada 12,14
// para fora; o que sobra é margem e fica de fora da caixa.
//
// Os outros são desenhados aqui. Os glifos são do Lucide (lucide.dev,
// ISC) e as marcas do Simple Icons (CC0) — ver NOTICE.md. O que segue
// as regras da Apple é a *geometria*, que é matemática e não obra
// protegida.
//
// A forma: o canto contínuo, com raio de 22,37% do lado — a medida da
// máscara dos ícones do iOS. Um canto contínuo não é um arco de
// círculo: o arco só cobre 36° no meio do canto, e de cada lado dele
// entram duas curvas de Bézier que o entregam ao lado a direito sem
// salto de curvatura. Por isso o canto ocupa 35,79 do lado (1,6× o
// raio) e o lado a direito só existe entre 35,79 e 64,21. É esta
// transição suave — e não o raio — que distingue a forma da Apple de
// um `border-radius` qualquer.
//
// O resto: margem de ~10%, o motivo principal a ocupar cerca de dois
// terços do lado, e o traço na ordem dos 6%. As cores são os valores
// das cores de sistema do iOS, com o gradiente que a Apple usa:
// aclarar em cima, escurecer ligeiramente em baixo.
import { getImage } from 'astro:assets';
import finder from '../../assets/icons/finder.png';
import notes from '../../assets/icons/notes.png';
import mail from '../../assets/icons/mail.png';
import safari from '../../assets/icons/safari.png';
import terminal from '../../assets/icons/terminal.webp';
import settings from '../../assets/icons/settings.png';
import stocks from '../../assets/icons/stocks.jpg';
import safari26 from '../../assets/icons/safari26.png';
import iosNotes from '../../assets/icons/ios/notes.png';
import iosMail from '../../assets/icons/ios/mail.svg';
import iosContacts from '../../assets/icons/ios/contacts.svg';

const ICON_PX = 256;
const shrink = (src: ImageMetadata) => getImage({ src, width: ICON_PX, height: ICON_PX, format: 'webp' });

/** Que ícone verdadeiro serve cada aplicação. */
const real: Record<string, string> = {
  sobre: (await shrink(finder)).src,
  escritos: (await shrink(notes)).src,
  contacto: (await shrink(mail)).src,
  projetos: (await shrink(safari)).src,
  terminal: (await shrink(terminal)).src,
  definicoes: (await shrink(settings)).src,
  bolsa: (await shrink(stocks)).src,
};

/** A imagem no lugar do quadrado: 1024/824 do lado, 100/824 para fora. */
const FIT = { size: (100 * 1024) / 824, offset: (-100 * 100) / 824 };

/**
 * No telefone os ícones são os do iOS: sem margem, sem sombra, a
 * encher o quadrado. Onde o iOS tem um ícone próprio (Contactos, Notas,
 * Mail, Safari) é esse; onde a imagem é a mesma nos dois sistemas
 * (Mensagens, Calendário, Bolsa) o desenho serve os dois. Os SVG vão
 * tal como estão — o Astro não os toca — e o PNG das Notas já tem o
 * tamanho de um ícone do iPhone a 3×.
 */
const ios: Record<string, string> = {
  sobre: iosContacts.src,
  escritos: iosNotes.src,
  contacto: iosMail.src,
  projetos: (await shrink(safari26)).src,
};
/** O Safari 26 traz 3 % de margem à volta do quadrado. */
const FIT26 = { size: (100 * 300) / 282, offset: (-9 * 100) / 282 };
---
<svg class="sprite" aria-hidden="true" focusable="false" width="0" height="0">
  <defs>
    <linearGradient id="g-mensagens" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5bf675"/><stop offset="1" stop-color="#0cbd2a"/></linearGradient>
    <linearGradient id="g-definicoes" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#A7A7AB"/><stop offset="1" stop-color="#85858A"/></linearGradient>
    <linearGradient id="g-disk" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#D3D3D7"/><stop offset="1" stop-color="#BBBBC0"/></linearGradient>
    <linearGradient id="g-doc" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3897FF"/><stop offset="1" stop-color="#0073F0"/></linearGradient>
    <linearGradient id="g-simulador" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3A4A63"/><stop offset="1" stop-color="#101827"/></linearGradient>
    <radialGradient id="g-spot" cx=".32" cy=".14" r=".9">
      <stop offset="0" stop-color="#fff" stop-opacity=".20"/>
      <stop offset="1" stop-color="#fff" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="g-shade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#000" stop-opacity="0"/>
      <stop offset=".6" stop-color="#000" stop-opacity="0"/>
      <stop offset="1" stop-color="#000" stop-opacity=".13"/>
    </linearGradient>
    <clipPath id="sq"><path d="M 35.792 0 L 64.208 0 c 12.528 0 18.793 0 23.578 2.438 a 22.37 22.37 0 0 1 9.776 9.776 c 2.438 4.785 2.438 11.049 2.438 23.578 L 100 64.208 c 0 12.528 0 18.793 -2.438 23.578 a 22.37 22.37 0 0 1 -9.776 9.776 c -4.785 2.438 -11.049 2.438 -23.578 2.438 L 35.792 100 c -12.528 0 -18.793 0 -23.578 -2.438 a 22.37 22.37 0 0 1 -9.776 -9.776 c -2.438 -4.785 -2.438 -11.049 -2.438 -23.578 L 0 35.792 c 0 -12.528 0 -18.793 2.438 -23.578 a 22.37 22.37 0 0 1 9.776 -9.776 c 4.785 -2.438 11.049 -2.438 23.578 -2.438 Z"/></clipPath>
  </defs>

  <!-- ── O mapa de refração ──────────────────────────────────────
       O vermelho diz quanto cada ponto do fundo se desloca na
       horizontal, o verde na vertical; 128 é ficar quieto. Junto às
       bordas os valores afastam-se de 128, e é aí que o fundo se
       entorta — como acontece na borda de uma lente. O centro fica
       intacto, para o conteúdo continuar legível.
       Só o Chromium aplica filtros SVG a `backdrop-filter`; nos
       outros esta camada não pinta nada e o vidro por baixo mantém-se.
       ────────────────────────────────────────────────────────── -->
  <filter id="lg-refract" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
    <feImage href="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='240' height='240'%3E%3Cdefs%3E%3ClinearGradient id='x' x1='0' y1='0' x2='1' y2='0'%3E%3Cstop offset='0' stop-color='rgb(0,0,0)'/%3E%3Cstop offset='0.13' stop-color='rgb(128,0,0)'/%3E%3Cstop offset='0.87' stop-color='rgb(128,0,0)'/%3E%3Cstop offset='1' stop-color='rgb(255,0,0)'/%3E%3C/linearGradient%3E%3ClinearGradient id='y' x1='0' y1='0' x2='0' y2='1'%3E%3Cstop offset='0' stop-color='rgb(0,0,0)'/%3E%3Cstop offset='0.13' stop-color='rgb(0,128,0)'/%3E%3Cstop offset='0.87' stop-color='rgb(0,128,0)'/%3E%3Cstop offset='1' stop-color='rgb(0,255,0)'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='240' height='240' fill='url(%23x)'/%3E%3Crect width='240' height='240' fill='url(%23y)' style='mix-blend-mode:screen'/%3E%3C/svg%3E" preserveAspectRatio="none" x="0%" y="0%" width="100%" height="100%" result="mapa" />
    <feDisplacementMap in="SourceGraphic" in2="mapa" scale="10" xChannelSelector="R" yChannelSelector="G" />
  </filter>

  <symbol id="icon-sobre" viewBox="0 0 100 100">
    <g class="ic-mac"><image href={real.sobre} x={FIT.offset} y={FIT.offset} width={FIT.size} height={FIT.size} /></g>
    <g class="ic-ios" clip-path="url(#sq)"><image href={ios.sobre} width="100" height="100" /></g>
  </symbol>
  <symbol id="icon-contacto" viewBox="0 0 100 100">
