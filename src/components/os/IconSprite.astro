  <symbol id="ui-moon" viewBox="0 0 100 100"><g transform="translate(8.00 8.00) scale(3.5000)" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></g></symbol>
  <symbol id="ui-globe" viewBox="0 0 100 100"><g transform="translate(8.00 8.00) scale(3.5000)" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /> <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" /> <path d="M2 12h20" /></g></symbol>
