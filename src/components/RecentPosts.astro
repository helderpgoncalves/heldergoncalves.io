---
// ─────────────────────────────────────────────────────────────
// RecentPosts — os posts mais recentes do Substack, em cards, para
// a landing. Puxa a curiosidade (data, tempo de leitura, resumo) e
// leva ao arquivo completo em /blog. Bilingue via data-pt/data-en.
// ─────────────────────────────────────────────────────────────
import { getSubstackPosts } from '../lib/substack';

interface Props {
  limit?: number;
}
const { limit = 3 } = Astro.props;
const posts = (await getSubstackPosts()).slice(0, limit);

const fmt = (d: Date) =>
  d.toLocaleDateString('pt-PT', { day: '2-digit', month: 'short', year: 'numeric' });
---
{posts.length > 0 && (
  <div class="recent">
    <div class="recent-head reveal">
      <div>
        <p class="recent-eyebrow" data-pt="Do arquivo" data-en="From the archive">Do arquivo</p>
        <h3 class="recent-h3 serif">
          <span data-pt="Escrita recente" data-en="Recent writing">Escrita recente</span>
        </h3>
      </div>
      <a href="/blog" class="recent-all">
        <span data-pt="Ver tudo" data-en="See all">Ver tudo</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <ul class="recent-grid">
      {posts.map((post, i) => (
        <li class="recent-card liquid-glass reveal-up" data-delay={i * 120}>
          <a href={`/blog/${post.slug}/`}>
            {post.cover && (
              <div class="recent-cover">
                <img src={post.cover} alt="" loading="lazy" decoding="async" />
              </div>
            )}
            <div class="recent-body">
              <div class="recent-meta">
                <time datetime={post.pubDate.toISOString()}>{fmt(post.pubDate)}</time>
                <span class="recent-dot" aria-hidden="true"></span>
                <span>
                  {post.readingMinutes}
                  <span data-pt=" min de leitura" data-en=" min read"> min de leitura</span>
                </span>
              </div>
              <h4 class="recent-title serif">{post.title}</h4>
              <p class="recent-desc">{post.description}</p>
              <span class="recent-read">
                <span data-pt="Ler" data-en="Read">Ler</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
)}
