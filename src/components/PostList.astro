---
// Lista de escritos: data, título e uma linha de resumo.
import { COPY, formatDate, type Lang } from '../siteConfig';
import { postPath, type Post } from '../lib/posts';

interface Props { posts: Post[]; lang: Lang }
const { posts, lang } = Astro.props;
const c = COPY[lang];
---
{posts.length === 0 ? (
  <p class="lead">{c.blog.empty}</p>
) : (
  <ul class="posts">
    {posts.map((post) => (
      <li class="post-item">
        <a href={postPath(post, lang)}>
          <time datetime={post.data.date.toISOString().slice(0, 10)}>
            {formatDate(post.data.date, lang)}
          </time>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
        </a>
      </li>
    ))}
  </ul>
)}
