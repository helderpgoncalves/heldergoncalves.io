---
// Spotlight — o projecto/foco em destaque. Sem métricas inventadas:
// diz em que é que ando a trabalhar e o que costuma sair daí.
interface Props { video: string }
const { video } = Astro.props;

const bullets = [
  { pt: 'Ferramentas com LLMs e agentes', en: 'Tools built on LLMs and agents' },
  { pt: 'Automação de trabalho repetitivo', en: 'Automation of repetitive work' },
  { pt: 'Interfaces rápidas e cuidadas', en: 'Fast, carefully built interfaces' },
  { pt: 'Do protótipo ao deploy em produção', en: 'From prototype to production deploy' },
];
---
<section class="zx-section" id="work">
  <div class="zx-shell">
    <div class="zx-inner">
      <div class="zx-head-split zx-rise">
        <div class="col">
          <div class="zx-badge">
            <span class="spark" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.2 6.1L20 10l-5.8 1.9L12 18l-2.2-6.1L4 10l5.8-1.9L12 2z"/></svg>
            </span>
            <span data-pt="Trabalho" data-en="Work">Trabalho</span>
          </div>
          <h2 class="zx-h2" data-pt="O que ando a construir agora" data-en="What I'm building right now">O que ando a construir agora</h2>
        </div>
        <p class="zx-lead"
          data-pt="Projetos onde junto código e inteligência artificial para resolver coisas concretas. Os casos de estudo detalhados chegam em breve."
          data-en="Projects where I mix code and artificial intelligence to solve concrete problems. Detailed case studies are coming soon.">Projetos onde junto código e inteligência artificial para resolver coisas concretas. Os casos de estudo detalhados chegam em breve.</p>
      </div>

      <div class="zx-spot">
        <div class="zx-spot-media zx-rise">
          <video src={video} autoplay loop muted playsinline preload="none" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"></video>
        </div>

        <div class="zx-spot-card zx-rise">
          <div class="zx-spot-in">
            <div class="zx-spot-logo">
              <span aria-hidden="true" style="width:34px;height:34px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(140deg,#3c85f4,#39bcf9);color:#fff;font-weight:700">H</span>
              <span data-pt="Em construção" data-en="In the making">Em construção</span>
            </div>

            <h4 data-pt="&ldquo;A melhor forma que conheço de perceber uma tecnologia é construir alguma coisa a sério com ela.&rdquo;"
                data-en="&ldquo;The best way I know to understand a technology is to build something real with it.&rdquo;">&ldquo;A melhor forma que conheço de perceber uma tecnologia é construir alguma coisa a sério com ela.&rdquo;</h4>

            <p data-pt="Passo os dias entre código e modelos de linguagem: a testar ideias, a automatizar o que é repetitivo e a transformar protótipos em produtos que alguém usa mesmo. Este site é o sítio onde vou deixando o registo disso."
               data-en="I spend my days between code and language models: testing ideas, automating the repetitive parts and turning prototypes into products people actually use. This site is where I keep the record of it.">Passo os dias entre código e modelos de linguagem: a testar ideias, a automatizar o que é repetitivo e a transformar protótipos em produtos que alguém usa mesmo. Este site é o sítio onde vou deixando o registo disso.</p>

            <h5 data-pt="Onde entro:" data-en="Where I come in:">Onde entro:</h5>
            <div class="zx-list">
              {bullets.map((b) => (
                <div>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                  <span data-pt={b.pt} data-en={b.en}>{b.pt}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
