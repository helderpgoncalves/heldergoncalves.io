---
// Focus — o "sobre" da página. Parágrafo que ganha cor à medida que
// se faz scroll, cartão em vídeo com uma frase, três pilares de
// trabalho e a stack. Sem números inventados.
interface Props { video: string }
const { video } = Astro.props;

const PT = 'A minha forma de trabalhar é simples: perceber o problema a fundo, construir a versão mais pequena que já responde a ele, e melhorá-la com o que a realidade ensinar. Menos slides, mais coisas a funcionar.';
const EN = 'The way I work is simple: understand the problem deeply, build the smallest version that already answers it, then improve it with whatever reality teaches. Fewer slides, more things that run.';
---
<section class="zx-section" id="focus">
  <div class="zx-shell">
    <div class="zx-inner">
      <div class="zx-badge">
        <span class="spark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.2 6.1L20 10l-5.8 1.9L12 18l-2.2-6.1L4 10l5.8-1.9L12 2z"/></svg>
        </span>
        <span data-pt="Sobre mim" data-en="About me">Sobre mim</span>
      </div>

      <p class="zx-reveal-text" id="zx-reveal-text" data-pt={PT} data-en={EN}>{PT}</p>

      <div class="zx-focus-row zx-rise">
        <div class="zx-quote-card">
          <video src={video} autoplay loop muted playsinline preload="none"></video>
          <p class="q"
            data-pt="Aprendo a construir e construo para aprender. Cada projeto começa numa pergunta e a resposta abre sempre a porta seguinte."
            data-en="I learn by building and build to learn. Every project starts with a question, and the answer always opens the next door.">Aprendo a construir e construo para aprender. Cada projeto começa numa pergunta e a resposta abre sempre a porta seguinte.</p>
          <div class="sig">
            <div>
              <strong>Hélder</strong>
              <span style="opacity:.8;font-size:16px" data-pt="Developer &amp; criador" data-en="Developer &amp; maker">Developer &amp; criador</span>
            </div>
            <p data-pt="Portugal · remoto" data-en="Portugal · remote">Portugal · remoto</p>
          </div>
        </div>

        <div class="zx-focus-side">
          <div class="zx-pillars">
            <div class="zx-pillar">
              <span class="ic" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
              </span>
              <h4 data-pt="Software" data-en="Software">Software</h4>
              <p data-pt="Aplicações web e serviços, do primeiro commit ao deploy em produção."
                 data-en="Web apps and services, from the first commit to production deploy.">Aplicações web e serviços, do primeiro commit ao deploy em produção.</p>
            </div>
            <div class="zx-pillar">
              <span class="ic" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="9"/></svg>
              </span>
              <h4 data-pt="Inteligência artificial" data-en="Artificial intelligence">Inteligência artificial</h4>
              <p data-pt="Modelos de linguagem, agentes e automação aplicada a trabalho real."
                 data-en="Language models, agents and automation applied to real work.">Modelos de linguagem, agentes e automação aplicada a trabalho real.</p>
            </div>
            <div class="zx-pillar">
              <span class="ic" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
              </span>
              <h4 data-pt="Escrita" data-en="Writing">Escrita</h4>
              <p data-pt="Notas sobre o que aprendo, na newsletter e aqui no blog."
                 data-en="Notes on what I learn, in the newsletter and here on the blog.">Notas sobre o que aprendo, na newsletter e aqui no blog.</p>
            </div>
          </div>

          <div class="zx-rule"></div>

          <div class="zx-stack">
            <span>TypeScript</span>
            <span>Python</span>
            <span>Astro</span>
            <span>Node</span>
            <span>Docker</span>
            <span>LLMs</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // ── Parágrafo que ganha cor letra a letra com o scroll ──
  (function () {
    var el = document.getElementById('zx-reveal-text');
    if (!el) return;

    function split() {
      var text = el!.textContent || '';
      el!.textContent = '';
      var frag = document.createDocumentFragment();
      text.split(' ').forEach(function (word, wi, arr) {
        var w = document.createElement('span');
        w.style.display = 'inline-block';
        w.style.whiteSpace = 'nowrap';
        word.split('').forEach(function (ch) {
          var s = document.createElement('span');
          s.setAttribute('data-ch', '');
          s.textContent = ch;
          w.appendChild(s);
        });
        frag.appendChild(w);
        if (wi < arr.length - 1) frag.appendChild(document.createTextNode(' '));
      });
      el!.appendChild(frag);
    }
    split();

    // Refaz a divisão sempre que a língua muda (o toggle repõe textContent).
    document.addEventListener('hg:lang', function () { split(); paint(); });

    function paint() {
      var chars = el!.querySelectorAll('[data-ch]');
      if (!chars.length) return;
      var r = el!.getBoundingClientRect();
      var vh = window.innerHeight;
      // 0 quando o topo entra a 85% do ecrã, 1 quando o fundo chega a 45%.
      var p = (vh * 0.85 - r.top) / Math.max(1, r.height + vh * 0.4);
      p = Math.min(1, Math.max(0, p));
      var upTo = Math.round(p * 1.15 * chars.length);
      for (var i = 0; i < chars.length; i++) {
        chars[i].classList.toggle('lit', i < upTo);
      }
    }

    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { paint(); ticking = false; });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    paint();
  })();
</script>
