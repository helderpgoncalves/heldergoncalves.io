---
// Hero — vídeo em fundo escuro, faixa de cartões a flutuar em curva,
// barra de navegação em pílula e o título principal. Bilingue PT/EN
// através dos atributos data-pt / data-en (ver script em index.astro).
import { SITE } from '../../siteConfig';

interface Props { video: string }
const { video } = Astro.props;

// Cartões da faixa — só CSS, sem imagens externas.
const chips = [
  { pt: 'Código', en: 'Code', sub: 'TypeScript · Python', g: '#1e3a8a,#3c85f4' },
  { pt: 'IA', en: 'AI', sub: 'LLMs · agentes', g: '#0f766e,#22c55e' },
  { pt: 'Automação', en: 'Automation', sub: 'workflows', g: '#7c2d12,#f59e0b' },
  { pt: 'Web', en: 'Web', sub: 'front-end', g: '#4c1d95,#a855f7' },
  { pt: 'Produto', en: 'Product', sub: 'do zero ao deploy', g: '#0c4a6e,#38bdf8' },
  { pt: 'Escrita', en: 'Writing', sub: 'newsletter', g: '#831843,#f472b6' },
  { pt: 'Infra', en: 'Infra', sub: 'Docker · Linux', g: '#134e4a,#2dd4bf' },
  { pt: 'Dados', en: 'Data', sub: 'pipelines', g: '#1e1b4b,#6366f1' },
  { pt: 'Design', en: 'Design', sub: 'interfaces', g: '#7f1d1d,#fb7185' },
  { pt: 'Ideias', en: 'Ideas', sub: 'side projects', g: '#052e16,#84cc16' },
];
---
<section class="zx-hero" id="top">
  <div class="zx-hero-bg">
    <video id="zx-hero-video" src={video} autoplay loop muted playsinline preload="auto"></video>
  </div>

  <!-- faixa de cartões (decorativa) -->
  <div class="zx-marquee" aria-hidden="true">
    <div class="zx-track" id="zx-track">
      {[...chips, ...chips, ...chips].map((c, i) => (
        <div class="zx-chip" data-i={i}>
          <div class="glow" style={`background:linear-gradient(150deg, ${c.g})`}></div>
          <span class="tag" data-pt={c.pt} data-en={c.en}>{c.pt}</span>
          <span class="sub">{c.sub}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- navegação -->
  <div class="zx-nav-wrap">
    <header class="zx-nav">
      <a href="#top" class="zx-brand" aria-label={SITE.name}>
        <span class="mark" aria-hidden="true">H</span>
        <span>Hélder Gonçalves</span>
      </a>
      <nav class="zx-nav-links">
        <a href="#top" class="active" data-pt="Início" data-en="Home">Início</a>
        <a href="#focus" data-pt="Sobre" data-en="About">Sobre</a>
        <a href="#work" data-pt="Trabalho" data-en="Work">Trabalho</a>
        <a href="#writing" data-pt="Escrita" data-en="Writing">Escrita</a>
      </nav>
      <div class="zx-nav-right">
        <div class="zx-lang" role="group" aria-label="Idioma">
          <button type="button" data-lang="pt" class="active">PT</button>
          <button type="button" data-lang="en">EN</button>
        </div>
        <a href="#contact" class="zx-btn" data-pt="Falar comigo" data-en="Get in touch">Falar comigo</a>
        <button type="button" class="zx-burger" id="zx-burger" aria-label="Menu" aria-expanded="false">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
        </button>
      </div>
    </header>
  </div>

  <div class="zx-mobile-menu" id="zx-mobile-menu">
    <a href="#focus" data-pt="Sobre" data-en="About">Sobre</a>
    <a href="#work" data-pt="Trabalho" data-en="Work">Trabalho</a>
    <a href="#writing" data-pt="Escrita" data-en="Writing">Escrita</a>
    <a href="#faq" data-pt="Perguntas" data-en="FAQ">Perguntas</a>
    <a href="#contact" class="zx-btn" style="width:100%" data-pt="Falar comigo" data-en="Get in touch">Falar comigo</a>
  </div>

  <!-- conteúdo -->
  <div class="zx-hero-body">
    <p class="zx-hero-kicker" data-pt="Developer · Criador · IA" data-en="Developer · Maker · AI">Developer · Criador · IA</p>
    <h1
      data-pt="Construir com curiosidade, entregar com método"
      data-en="Building with curiosity, shipping with method">Construir com curiosidade, entregar com método</h1>
    <p class="zx-hero-sub"
      data-pt="Sou o Hélder. Desenvolvo software, exploro inteligência artificial e transformo ideias em coisas que funcionam mesmo."
      data-en="I'm Hélder. I build software, explore artificial intelligence and turn ideas into things that actually work.">Sou o Hélder. Desenvolvo software, exploro inteligência artificial e transformo ideias em coisas que funcionam mesmo.</p>
    <div class="zx-hero-actions">
      <a href="#contact" class="zx-btn" data-pt="Falar comigo" data-en="Get in touch">Falar comigo</a>
      <a href="#work" class="zx-btn ghost" data-pt="Ver trabalho" data-en="See work">Ver trabalho</a>
    </div>
  </div>

  <div class="zx-hero-social">
    <a href={SITE.social.twitter} target="_blank" rel="noopener" aria-label="Twitter / X">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
    </a>
    <a href={SITE.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
    </a>
    <a href={SITE.social.substack} target="_blank" rel="noopener" aria-label="Substack">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 5.5H2V3h20v2.5ZM2 8.4h20V21l-10-5.6L2 21V8.4Z"/></svg>
    </a>
  </div>
</section>

<script>
  // ── Faixa de cartões: deslize contínuo em curva, com pausa ao hover ──
  (function () {
    var track = document.getElementById('zx-track');
    if (!track) return;
    var chips = Array.prototype.slice.call(track.querySelectorAll('.zx-chip')) as HTMLElement[];
    if (!chips.length) return;
    var paused = false;
    track.addEventListener('mouseenter', function () { paused = true; });
    track.addEventListener('mouseleave', function () { paused = false; });

    var t = 0;
    var last = performance.now();
    var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function frame(now: number) {
      var vw = window.innerWidth;
      var desktop = vw >= 1024;
      var w = desktop ? 165 : 140;
      var gap = desktop ? 64 : 24;
      var step = w + gap;
      var total = chips.length * step;
      var yPeak = desktop ? 20 : 30;
      var H = desktop ? 220 : 95;
      var Rmax = desktop ? 15 : 10;

      if (!paused && !still) t = (t + (now - last) * 0.045) % total;
      last = now;

      for (var i = 0; i < chips.length; i++) {
        var x = (i * step - t) % total;
        if (x < 0) x += total;
        var fx = x - total / 2 + vw / 2;
        var d = (fx + w / 2 - vw / 2) / 500;
        var y = yPeak + H * d * d;
        var rot = Math.max(-Rmax, Math.min(Rmax, d * Rmax));
        var scale = 1.05 - 0.12 * d * d;
        var op = Math.min(1, Math.max(0, (1.35 - Math.abs(d)) / 0.45));
        var el = chips[i];
        el.style.transform = 'translate(' + fx + 'px,' + y + 'px) rotate(' + rot + 'deg) scale(' + scale + ')';
        el.style.opacity = String(op);
      }
      if (!still) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
    if (still) window.addEventListener('resize', function () { frame(performance.now()); });
  })();

  // ── Menu mobile ──
  (function () {
    var b = document.getElementById('zx-burger');
    var m = document.getElementById('zx-mobile-menu');
    if (!b || !m) return;
    b.addEventListener('click', function () {
      var open = m!.classList.toggle('open');
      b!.setAttribute('aria-expanded', String(open));
    });
    m.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        m!.classList.remove('open');
        b!.setAttribute('aria-expanded', 'false');
      });
    });
  })();
</script>
