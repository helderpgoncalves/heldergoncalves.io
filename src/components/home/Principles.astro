---
// Principles — quatro cartões que se empilham à medida que se faz
// scroll (no desktop). No mobile ficam simplesmente em lista.
interface Props { video: string }
const { video } = Astro.props;

const items = [
  {
    n: '01',
    pt: { t: 'A pergunta certa vale mais do que a resposta rápida.', k: 'Curiosidade primeiro', s: 'Antes de escrever código' },
    en: { t: 'The right question is worth more than the fast answer.', k: 'Curiosity first', s: 'Before writing code' },
  },
  {
    n: '02',
    pt: { t: 'Uma ideia só conta quando existe, corre e alguém a consegue usar.', k: 'Enviar, não só sonhar', s: 'Do protótipo ao deploy' },
    en: { t: 'An idea only counts when it exists, runs and someone can use it.', k: "Ship, don't just dream", s: 'From prototype to deploy' },
  },
  {
    n: '03',
    pt: { t: 'A IA é uma ferramenta, não um fim. Serve quando poupa tempo a quem trabalha.', k: 'Tecnologia com propósito', s: 'IA aplicada' },
    en: { t: 'AI is a tool, not a goal. It earns its place when it saves real people time.', k: 'Technology with a purpose', s: 'Applied AI' },
  },
  {
    n: '04',
    pt: { t: 'Escrever sobre o que aprendo obriga-me a perceber melhor o que faço.', k: 'Aprender em público', s: 'Newsletter e blog' },
    en: { t: 'Writing about what I learn forces me to understand what I do.', k: 'Learning in public', s: 'Newsletter and blog' },
  },
];
---
<section class="zx-stackwrap" id="principles">
  <div class="frame">
    <video src={video} autoplay loop muted playsinline preload="none"></video>
    <div class="frame-in">
      <div class="zx-head-center zx-rise" style="padding:0 20px">
        <div class="zx-badge">
          <span class="spark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.2 6.1L20 10l-5.8 1.9L12 18l-2.2-6.1L4 10l5.8-1.9L12 2z"/></svg>
          </span>
          <span data-pt="Princípios" data-en="Principles">Princípios</span>
        </div>
        <h2 class="zx-h2" data-pt="Quatro ideias que guiam o trabalho" data-en="Four ideas that guide the work">Quatro ideias que guiam o trabalho</h2>
        <p class="zx-lead"
          data-pt="Não são regras, são hábitos. Ajudam-me a decidir depressa quando o caminho não é óbvio."
          data-en="Not rules, habits. They help me decide quickly when the path isn't obvious.">Não são regras, são hábitos. Ajudam-me a decidir depressa quando o caminho não é óbvio.</p>
      </div>

      <div class="zx-cards" id="zx-cards">
        {items.map((it, i) => (
          <article class="zx-quote zx-rise" data-card={i}>
            <div class="zx-quote-in">
              <div class="zx-quote-num" aria-hidden="true">{it.n}</div>
              <div class="zx-quote-body">
                <p class="t" data-pt={it.pt.t} data-en={it.en.t}>{it.pt.t}</p>
                <div class="who">
                  <h4 data-pt={it.pt.k} data-en={it.en.k}>{it.pt.k}</h4>
                  <p data-pt={it.pt.s} data-en={it.en.s}>{it.pt.s}</p>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Empilhamento só no desktop: cada cartão fica pegado ao topo. */
  @media (min-width: 1024px) {
    .zx-cards { display: flex; flex-direction: column; gap: 24px; }
    .zx-cards .zx-quote { position: sticky; top: 180px; }
    .zx-cards .zx-quote:nth-child(2) { top: 210px; }
    .zx-cards .zx-quote:nth-child(3) { top: 240px; }
    .zx-cards .zx-quote:nth-child(4) { top: 270px; }
  }
  @media (max-width: 1023px) {
    .zx-cards { display: flex; flex-direction: column; gap: 20px; }
  }
</style>
