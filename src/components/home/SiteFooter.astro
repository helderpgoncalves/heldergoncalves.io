---
// SiteFooter — CTA grande, colunas de links, newsletter (embed real do
// Substack) e redes. É também a secção de contacto (#contact).
import { SITE } from '../../siteConfig';
import Newsletter from '../Newsletter.astro';
---
<footer class="zx-footer" id="contact">
  <div class="zx-footer-in">
    <div class="zx-footer-grid">

      <div class="zx-cta">
        <h4 data-pt="Tens uma ideia? Vamos pô-la de pé." data-en="Got an idea? Let's get it running.">Tens uma ideia? Vamos pô-la de pé.</h4>
        <a href={`mailto:${SITE.email}`} class="zx-cta-big" id="zx-cta-big" data-pt="FALA COMIGO" data-en="GET IN TOUCH">FALA COMIGO</a>
        <p style="color:#c2c8d0;font-size:16px;margin-top:8px">{SITE.email}</p>
      </div>

      <div class="zx-footer-mid">
        <div class="zx-footer-cols">
          <div class="zx-footer-col">
            <h5 data-pt="Navegação" data-en="Navigation">Navegação</h5>
            <div>
              <a href="#focus" data-pt="Sobre" data-en="About">Sobre</a>
              <a href="#process" data-pt="Como trabalho" data-en="How I work">Como trabalho</a>
              <a href="#work" data-pt="Trabalho" data-en="Work">Trabalho</a>
            </div>
          </div>
          <div class="zx-footer-col">
            <h5 data-pt="Escrita" data-en="Writing">Escrita</h5>
            <div>
              <a href="/blog" data-pt="Blog" data-en="Blog">Blog</a>
              <a href={SITE.social.substack} target="_blank" rel="noopener">Substack</a>
              <a href="/rss.xml">RSS</a>
            </div>
          </div>
          <div class="zx-footer-col">
            <h5 data-pt="Contacto" data-en="Contact">Contacto</h5>
            <div>
              <a href={`mailto:${SITE.email}`}>Email</a>
              <a href={SITE.social.linkedin} target="_blank" rel="noopener">LinkedIn</a>
              <a href={SITE.social.twitter} target="_blank" rel="noopener">Twitter / X</a>
            </div>
          </div>
        </div>

        <div class="zx-footer-news" id="subscribe">
          <div>
            <h3 data-pt="Recebe a newsletter" data-en="Join the newsletter">Recebe a newsletter</h3>
            <p data-pt="Código, IA e o que ando a construir. Sem ruído."
               data-en="Code, AI and what I'm building. No noise.">Código, IA e o que ando a construir. Sem ruído.</p>
          </div>
          <Newsletter variant="panel" />
        </div>
      </div>

      <div class="zx-footer-bottom">
        <div class="zx-social">
          <a href={SITE.social.twitter} target="_blank" rel="noopener" aria-label="Twitter / X">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href={SITE.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
          <a href={SITE.social.substack} target="_blank" rel="noopener" aria-label="Substack">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M22 5.5H2V3h20v2.5ZM2 8.4h20V21l-10-5.6L2 21V8.4Z"/></svg>
          </a>
          <a href={`mailto:${SITE.email}`} aria-label="Email">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
          </a>
        </div>
        <p class="zx-copy">© <span id="zx-year"></span> · heldergoncalves.io</p>
      </div>

    </div>
  </div>
</footer>

<script>
  // Letras do CTA, uma a uma, com atraso em cascata.
  (function () {
    var el = document.getElementById('zx-cta-big');
    if (!el) return;
    function build() {
      var text = el!.textContent || '';
      el!.textContent = '';
      text.split('').forEach(function (ch, i) {
        var s = document.createElement('span');
        s.textContent = ch === ' ' ? ' ' : ch;
        s.style.animationDelay = (0.15 + i * 0.04) + 's';
        el!.appendChild(s);
      });
    }
    build();
    document.addEventListener('hg:lang', build);
  })();

  (function () {
    var y = document.getElementById('zx-year');
    if (y) y.textContent = String(new Date().getFullYear());
  })();
</script>
