---
// Faq — perguntas comuns, em acordeão. Respostas honestas e gerais.
interface Props { video: string }
const { video } = Astro.props;

const faqs = [
  {
    pt: { q: 'Em que é que trabalhas?', a: 'Desenvolvo software — sobretudo web — e trabalho com inteligência artificial: modelos de linguagem, agentes e automação. Gosto da parte em que a ideia passa a coisa a correr.' },
    en: { q: 'What do you work on?', a: 'I build software — mostly web — and work with artificial intelligence: language models, agents and automation. I like the part where an idea becomes something that runs.' },
  },
  {
    pt: { q: 'Estás disponível para projetos?', a: 'Depende da altura e do projeto. Manda-me uma mensagem com o contexto e digo-te com franqueza se faz sentido e quando poderia começar.' },
    en: { q: 'Are you available for projects?', a: 'Depends on timing and on the project. Send me a message with the context and I\'ll tell you honestly whether it makes sense and when I could start.' },
  },
  {
    pt: { q: 'Que tecnologias usas?', a: 'Sobretudo TypeScript e Python, com Node, Astro e Docker à volta. A escolha segue o problema — não ao contrário.' },
    en: { q: 'What technologies do you use?', a: 'Mostly TypeScript and Python, with Node, Astro and Docker around them. The stack follows the problem, not the other way round.' },
  },
  {
    pt: { q: 'Como é trabalhar contigo?', a: 'Conversa primeiro, protótipo cedo, entregas pequenas e frequentes. Prefiro mostrar alguma coisa a funcionar depressa a desaparecer semanas com um plano.' },
    en: { q: 'What is it like to work with you?', a: 'Conversation first, prototype early, small and frequent deliveries. I\'d rather show something working quickly than disappear for weeks with a plan.' },
  },
  {
    pt: { q: 'Onde escreves?', a: 'Na newsletter, que também podes ler aqui no blog. São notas curtas sobre código, IA e o que ando a construir.' },
    en: { q: 'Where do you write?', a: 'In the newsletter, which you can also read here on the blog. Short notes on code, AI and what I\'m building.' },
  },
  {
    pt: { q: 'Qual é a melhor forma de te contactar?', a: 'Email, sem rodeios. Também me encontras no LinkedIn e no X — respondo aos dois, mas ao email respondo melhor.' },
    en: { q: 'What is the best way to reach you?', a: 'Email, straight up. You can also find me on LinkedIn and X — I answer both, but email gets the better answer.' },
  },
];
---
<section class="zx-stackwrap" id="faq">
  <div class="frame">
    <video src={video} autoplay loop muted playsinline preload="none"></video>
    <div class="frame-in">
      <div class="zx-head-center zx-rise" style="padding:0 20px">
        <div class="zx-badge">
          <span class="spark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.2 6.1L20 10l-5.8 1.9L12 18l-2.2-6.1L4 10l5.8-1.9L12 2z"/></svg>
          </span>
          <span data-pt="Perguntas" data-en="FAQs">Perguntas</span>
        </div>
        <h2 class="zx-h2" data-pt="Tens dúvidas? Respondo já." data-en="Got questions? Here you go.">Tens dúvidas? Respondo já.</h2>
        <p class="zx-lead"
          data-pt="As coisas que me perguntam mais vezes — e o que respondo quando perguntam."
          data-en="The things people ask me most — and what I answer when they do.">As coisas que me perguntam mais vezes — e o que respondo quando perguntam.</p>
      </div>

      <div class="zx-faqs" id="zx-faqs">
        {faqs.map((f, i) => (
          <article class={`zx-faq${i === 0 ? ' open' : ''}`}>
            <div class="zx-faq-in">
              <button type="button" class="zx-faq-q" aria-expanded={i === 0 ? 'true' : 'false'}>
                <p data-pt={f.pt.q} data-en={f.en.q}>{f.pt.q}</p>
                <span class="zx-faq-ic" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </span>
              </button>
              <div class="zx-faq-a">
                <p data-pt={f.pt.a} data-en={f.en.a}>{f.pt.a}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .zx-faq-q { width: 100%; text-align: left; background: none; border: none; padding: 0; cursor: pointer; }
  .zx-faq.open .zx-faq-ic svg { transform: rotate(45deg); }
  .zx-faq-ic svg { transition: transform 0.3s ease; }
</style>

<script>
  (function () {
    var wrap = document.getElementById('zx-faqs');
    if (!wrap) return;
    var items = Array.prototype.slice.call(wrap.querySelectorAll('.zx-faq')) as HTMLElement[];

    function setHeight(el: HTMLElement, open: boolean) {
      var panel = el.querySelector('.zx-faq-a') as HTMLElement | null;
      if (!panel) return;
      panel.style.height = open ? panel.scrollHeight + 'px' : '0px';
    }

    items.forEach(function (el) {
      var btn = el.querySelector('.zx-faq-q') as HTMLButtonElement | null;
      setHeight(el, el.classList.contains('open'));
      if (!btn) return;
      btn.addEventListener('click', function () {
        var willOpen = !el.classList.contains('open');
        items.forEach(function (o) {
          o.classList.remove('open');
          var b = o.querySelector('.zx-faq-q');
          if (b) b.setAttribute('aria-expanded', 'false');
          setHeight(o, false);
        });
        if (willOpen) {
          el.classList.add('open');
          btn!.setAttribute('aria-expanded', 'true');
          setHeight(el, true);
        }
      });
    });

    // Recalcula alturas quando a língua muda ou a janela muda de tamanho.
    function refresh() {
      items.forEach(function (el) { setHeight(el, el.classList.contains('open')); });
    }
    window.addEventListener('resize', refresh);
    document.addEventListener('hg:lang', refresh);
  })();
</script>
