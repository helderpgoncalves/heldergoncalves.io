---
// Writing — os posts mais recentes do Substack, em cards arrastáveis.
// Se o feed estiver em baixo, a secção mantém-se com o convite a ler.
import { getSubstackPosts } from '../../lib/substack';

const posts = (await getSubstackPosts()).slice(0, 4);
const fmt = (d: Date) => d.toLocaleDateString('pt-PT', { day: '2-digit', month: 'short', year: 'numeric' });
---
<section class="zx-section" id="writing">
  <div class="zx-shell">
    <div class="zx-inner">
      <div class="zx-head-split zx-rise">
        <div class="col">
          <div class="zx-badge">
            <span class="spark" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.2 6.1L20 10l-5.8 1.9L12 18l-2.2-6.1L4 10l5.8-1.9L12 2z"/></svg>
            </span>
            <span data-pt="Escrita" data-en="Writing">Escrita</span>
          </div>
          <h2 class="zx-h2" data-pt="Notas sobre o que ando a aprender" data-en="Notes on what I'm learning">Notas sobre o que ando a aprender</h2>
        </div>
        <p class="zx-lead"
          data-pt="Escrevo sobre desenvolvimento, inteligência artificial e as coisas que vou construindo. Sem calendário rígido — só quando há algo que vale a pena partilhar."
          data-en="I write about development, artificial intelligence and the things I build. No rigid schedule — only when there's something worth sharing.">Escrevo sobre desenvolvimento, inteligência artificial e as coisas que vou construindo. Sem calendário rígido — só quando há algo que vale a pena partilhar.</p>
      </div>

      {posts.length > 0 ? (
        <div class="zx-posts" id="zx-posts">
          {posts.map((post) => (
            <a class="zx-post" href={`/blog/${post.slug}/`}>
              {post.cover && (
                <div class="zx-post-cover">
                  <img src={post.cover} alt="" loading="lazy" decoding="async" />
                </div>
              )}
              <div class="zx-post-body">
                <div class="zx-post-meta">
                  <span class="tag">{post.readingMinutes}<span data-pt=" min" data-en=" min"> min</span></span>
                  <span class="dt">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    <time datetime={post.pubDate.toISOString()}>{fmt(post.pubDate)}</time>
                  </span>
                </div>
                <h3>{post.title}</h3>
                <span class="zx-post-read">
                  <span data-pt="Ler" data-en="Read">Ler</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="zx-post-empty"
           data-pt="Os textos vivem no Substack. Passa por lá enquanto o arquivo aqui não carrega."
           data-en="The posts live on Substack. Head over there while the archive here isn't loading.">Os textos vivem no Substack. Passa por lá enquanto o arquivo aqui não carrega.</p>
      )}

      <div style="display:flex;gap:16px;flex-wrap:wrap">
        <a href="/blog" class="zx-btn dark" data-pt="Ver todos os textos" data-en="See all writing">Ver todos os textos</a>
      </div>
    </div>
  </div>
</section>

<script>
  // Arrastar os cards com o rato (o scroll normal já funciona no touch).
  (function () {
    var list = document.getElementById('zx-posts');
    if (!list) return;
    var down = false, startX = 0, startScroll = 0, moved = 0;
    list.addEventListener('mousedown', function (e: MouseEvent) {
      down = true; moved = 0;
      startX = e.pageX; startScroll = list!.scrollLeft;
      list!.classList.add('dragging');
    });
    window.addEventListener('mouseup', function () { down = false; list!.classList.remove('dragging'); });
    list.addEventListener('mousemove', function (e: MouseEvent) {
      if (!down) return;
      e.preventDefault();
      var walk = (e.pageX - startX) * 1.4;
      moved = Math.abs(walk);
      list!.scrollLeft = startScroll - walk;
    });
    // Evita abrir o post quando o gesto foi um arrasto.
    list.addEventListener('click', function (e: MouseEvent) {
      if (moved > 8) { e.preventDefault(); moved = 0; }
    }, true);
  })();
</script>
