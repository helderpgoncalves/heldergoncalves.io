---
// Cabeçalho, corpo e pé de um artigo. O conteúdo em si entra no slot.
import { type Lang } from '../siteConfig';
import { useT, formatDate } from '../i18n/ui';
import type { Post } from '../lib/posts';

interface Props { lang: Lang; post: Post }
const { lang, post } = Astro.props;
const t = useT(lang);
const blog = lang === 'pt' ? '/blog/' : '/en/blog/';
---
<article class="article">
  <div class="wrap">
    <a class="link-more back" href={blog}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
      {t('writing.back')}
    </a>

    <header class="article-head">
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <p class="article-meta">
        <time datetime={post.data.date.toISOString()}>
          {t('writing.published')} {formatDate(post.data.date, lang)}
        </time>
        <span aria-hidden="true">·</span>
        <span>{post.readingMinutes} {t('writing.readingTime')}</span>
        {post.data.tags.length > 0 && (
          <>
            <span aria-hidden="true">·</span>
            <span>{post.data.tags.join(' · ')}</span>
          </>
        )}
      </p>
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="article-foot">
      <a class="link-more" href={blog}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
        {t('writing.back')}
      </a>
    </footer>
  </div>
</article>

<style>
  .back { margin: 0 0 28px; }
</style>
