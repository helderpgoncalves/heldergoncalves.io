---
// Um escrito: cabeçalho, corpo em Markdown e pé de página.
import { SITE, COPY, ROUTES, formatDate, readingMinutes, type Lang } from '../siteConfig';
import type { Post } from '../lib/posts';

interface Props { post: Post; lang: Lang; altPath?: string }
const { post, lang, altPath } = Astro.props;

const c = COPY[lang];
const { Content } = await post.render();
const minutes = readingMinutes(post.body);
const iso = (d: Date) => d.toISOString().slice(0, 10);
const mailto = `mailto:${SITE.email}?subject=${encodeURIComponent(post.data.title)}`;
---
<article class="article">
  <header class="article-head">
    <p class="eyebrow">
      <time datetime={iso(post.data.date)}>{formatDate(post.data.date, lang)}</time>
      <span class="dot" aria-hidden="true">·</span>{minutes} {c.post.readingTime}
    </p>
    <h1 class="display">{post.data.title}</h1>
    <p class="lead">{post.data.description}</p>
    {post.data.updated && (
      <p class="meta">
        {c.post.updated} <time datetime={iso(post.data.updated)}>{formatDate(post.data.updated, lang)}</time>
      </p>
    )}
    {altPath && <p class="meta"><a href={altPath}>{c.post.readOther} →</a></p>}
  </header>

  <div class="prose">
    <Content />
  </div>

  <footer class="article-foot">
    {post.data.tags.length > 0 && (
      <p class="tags">
        {post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
      </p>
    )}
    <p>{c.post.talk} <a href={mailto}>{c.post.talkLink}</a></p>
    <p><a class="back" href={ROUTES[lang].blog}>{c.post.backToBlog}</a></p>
  </footer>
</article>
