{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run texto*)",
      "Bash(npm run lixo)",
      "Bash(npm run build)",
      "Bash(npm run verificar*)",
      "Bash(npm audit*)",
      "Bash(npm outdated*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  }
}
