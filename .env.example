# Copia para .env.local (nunca vai para o git). No Coolify, estas são as variáveis de ambiente da app.

# Endereço público deste ambiente. Em desenvolvimento: http://127.0.0.1:3100
SITE_URL=https://heldergoncalves.io

# --- Resend (https://resend.com) ---
# Chave de API (permissão "Full access": cria contactos e broadcasts).
RESEND_API_KEY=
# Um segmento por língua; o ID está no painel do Resend, em Audience > Segments.
RESEND_SEGMENT_PT=
RESEND_SEGMENT_EN=
# O domínio de envio tem de estar verificado no Resend (SPF + DKIM).
RESEND_FROM="Hélder Gonçalves <newsletter@heldergoncalves.io>"

# Segredo que assina os links de confirmação. Mínimo 32 caracteres, aleatório:
#   openssl rand -base64 36
NEWSLETTER_SECRET=

# --- Aviso automático de artigos novos (scripts/notificar.mjs, corre após cada deploy) ---
# Só envia se for 1. Deixa 0 até teres testado com `npm run notificar -- --dry`.
NOTIFICAR=0
# Só avisa artigos com data dentro desta janela (dias), para um deploy antigo não reenviar tudo.
NOTIFICAR_JANELA_DIAS=7
# Minutos de atraso no envio, para o artigo já estar no ar quando o e-mail chegar.
NOTIFICAR_ATRASO_MIN=15

# --- Mini-app microsoft.helder.si ---
# O custo médio de compra (em euros) de MSF.F: dados financeiros, por isso só aqui, nunca no repositório.
#   custo médio = soma(quantidade × preço de compra) / soma(quantidade)
MSFT_CUSTO_MEDIO=
# Quem modera o chat (apaga qualquer mensagem) apresenta isto em /moderar. Mínimo 24 caracteres.
#   openssl rand -hex 24
MSFT_ADMIN_TOKEN=
# Onde ficam os comentários (um ficheiro). Em produção é o volume /data; em desenvolvimento, ./data.
# DATA_DIR=/data

# --- Só para testes ---
# Aponta o Resend para um servidor-falso local, em vez de https://api.resend.com
# RESEND_API_URL=http://127.0.0.1:4010
# Aponta o Yahoo para um servidor-falso (para ver o tempo real com a bolsa fechada)
# YAHOO_URL=http://127.0.0.1:4020
