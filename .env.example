# ─────────────────────────────────────────────────────────────────────
# Todas as variáveis que a API lê (ver api/app/config.py). Copia para
# `.env` — que nunca entra no repositório — e preenche só o que
# precisares: sem nenhuma delas o site continua a funcionar, só que com
# o contacto a voltar ao `mailto:` e sem Mensagens, Calendário ou
# newsletter ligados.
#
#   cp .env.example .env
#
# Em produção (Coolify), estas variáveis vão em Environment Variables
# do recurso — nunca num ficheiro dentro da imagem. Ver DEPLOY.md.
# ─────────────────────────────────────────────────────────────────────

# ── Geral ────────────────────────────────────────────────────────────
SITE_ORIGIN=https://heldergoncalves.io
# 0 para não confiar no X-Forwarded-For (só em dev, sem proxy à frente)
TRUST_PROXY=1

# ── Email (contacto, newsletter, sessões, reuniões) ─────────────────
# 'resend' ou 'webhook'
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_WEBHOOK_URL=
MAIL_FROM=site@heldergoncalves.io
MAIL_TO=helder@heldergoncalves.io

# ── Newsletter ───────────────────────────────────────────────────────
# Uma frase longa e aleatória; se não definires, a API gera uma e
# guarda-a em DATA_DIR/.subscribe-secret — mas só sobrevive a reinícios
# se o volume estiver montado.
SUBSCRIBE_SECRET=

# ── Sessões (entrar no Calendário) ──────────────────────────────────
# O mesmo princípio do SUBSCRIBE_SECRET.
SESSION_SECRET=

# O email do Hélder. Quem entrar no Calendário com este email (o mesmo
# código de seis algarismos que qualquer visitante recebe) vê a agenda
# cheia e pode criar bloqueios e aberturas na disponibilidade. Sem esta
# variável, ninguém tem esse papel — o Calendário fica só no modo de
# visitante.
OWNER_EMAIL=

# ── Conversa (OpenRouter) ────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5

# ── Marcação de conversas fora do Calendário (opcional) ─────────────
BOOKING_URL=
BOOKING_WEBHOOK_URL=

# ── Calendário: quando o Hélder está disponível ─────────────────────
MEETINGS_TZ=Europe/Lisbon
MEETINGS_DAYS=1-5
MEETINGS_WINDOWS=10:00-12:00,15:00-18:00
MEETING_MINUTES=30
MEETINGS_HORIZON_DAYS=60
MEETINGS_NOTICE_HOURS=12
