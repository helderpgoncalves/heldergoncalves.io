# ─────────────────────────────────────────────────────────────────────
# Todas as variáveis que a API lê (ver api/app/config.py). Copia para
# `.env` — que nunca entra no repositório — e preenche só o que
# precisares: sem nenhuma delas o site continua a funcionar, só que com
# o contacto a voltar ao `mailto:` e sem Mensagens, Calendário ou
# newsletter ligados.
#
#   cp .env.example .env
#
# Em produção (Coolify), estas variáveis vão em Environment Variables
# do recurso — nunca num ficheiro dentro da imagem. Ver DEPLOY.md.
# ─────────────────────────────────────────────────────────────────────

# ── Geral ────────────────────────────────────────────────────────────
SITE_ORIGIN=https://heldergoncalves.io
# 0 para não confiar no X-Forwarded-For (só em dev, sem proxy à frente)
TRUST_PROXY=1

# ── Email (contacto, newsletter, sessões, reuniões) ─────────────────
# 'resend' ou 'webhook'
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_WEBHOOK_URL=
MAIL_FROM=site@heldergoncalves.io
MAIL_TO=helder@heldergoncalves.io

# ── Newsletter ───────────────────────────────────────────────────────
# Uma frase longa e aleatória; se não definires, a API gera uma e
# guarda-a em DATA_DIR/.subscribe-secret — mas só sobrevive a reinícios
# se o volume estiver montado.
SUBSCRIBE_SECRET=

# ── Sessões (entrar no Calendário e nos comentários) ────────────────
# O mesmo princípio do SUBSCRIBE_SECRET, e **define-a mesmo**: é ela que
# assina os cookies. Se o segredo mudar entre publicações, toda a gente
# aparece de fora sem ter saído — e sem esta variável ele só sobrevive
# enquanto o volume do DATA_DIR sobreviver. Ver DEPLOY.md.
SESSION_SECRET=

# Só enquanto se troca o SESSION_SECRET: põe aqui o antigo (vários,
# separados por vírgula) e as sessões que já existiam continuam a ser
# lidas, migrando sozinhas para o novo. Tira-se passado o prazo delas.
SESSION_SECRET_PREVIOUS=

# O email do Hélder. Quem entrar com este email (por código ou pela
# Google) vê a agenda cheia, pode criar bloqueios e aberturas na
# disponibilidade, e lê a caixa de entrada das Mensagens. Sem esta
# variável, ninguém tem esse papel — tudo fica só no modo de visitante.
OWNER_EMAIL=

# ── Entrar com a Google (opcional) ──────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (tipo "Web application"). Redirect URI autorizado:
#   https://heldergoncalves.io/api/auth/google/callback
# O consent screen precisa de um link de política de privacidade — usa
# https://heldergoncalves.io/privacidade/ (ou /en/privacy/).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Conversa (OpenRouter) ────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5

# ── Marcação de conversas fora do Calendário (opcional) ─────────────
BOOKING_URL=
BOOKING_WEBHOOK_URL=

# ── Calendário: quando o Hélder está disponível ─────────────────────
MEETINGS_TZ=Europe/Lisbon
MEETINGS_DAYS=1-5
MEETINGS_WINDOWS=10:00-12:00,15:00-18:00
MEETING_MINUTES=30
MEETINGS_HORIZON_DAYS=60
MEETINGS_NOTICE_HOURS=12

# ── Onde vivem os ficheiros partilhados ─────────────────────────────
# **Deixa isto vazio e não gastas RAM nenhuma**: sem endpoint, os bytes
# ficam no disco, dentro do DATA_DIR, e não corre processo nenhum a mais.
# É o que chega a um servidor só.
#
# Preencher isto liga o modo S3 — e só liga se estiver TUDO preenchido:
# metade da configuração e a API escrevia para um armazém que não
# responde. Não traz biblioteca nova (ver api/app/armazem.py); o que
# traz, se o armazém correr na mesma máquina, é o processo dele. Em
# desenvolvimento é o Garage, em 256 MB; em produção aponta antes para
# um armazém que já exista, e a RAM daqui fica na mesma.
ARMAZEM_ENDPOINT=
ARMAZEM_BALDE=ficheiros
ARMAZEM_REGIAO=garage
ARMAZEM_CHAVE=
ARMAZEM_SECRETA=
